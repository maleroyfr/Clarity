{
  "schemaVersion": "1.0",
  "id": "m365.mailboxUsageDetail",
  "version": "1.0.0",
  "name": "Microsoft 365 mailbox usage detail report",
  "readiness": "SyntheticValidated",
  "producerId": "report.m365.mailboxUsageDetail",
  "capabilityId": "exchange.mailboxUsage",
  "environmentKind": "M365Tenant",
  "scopeKind": "tenant",
  "refreshDateColumn": "Report Refresh Date",
  "periodColumn": "Report Period",
  "format": { "kind": "csv", "encoding": "utf-8", "delimiter": ",", "extension": ".csv", "dateFormat": "yyyy-MM-dd" },
  "object": {
    "type": "mailbox",
    "identities": [{ "column": "User Principal Name", "namespace": "m365report.upn", "format": "upn" }],
    "alternativeKeys": []
  },
  "columns": [
    { "header": "Report Refresh Date", "field": "reportRefreshDate", "type": "date", "required": true },
    { "header": "User Principal Name", "field": "userPrincipalName", "type": "upn", "required": true, "concealable": true },
    { "header": "Display Name", "field": "displayName", "type": "string", "required": true, "concealable": true },
    { "header": "Is Deleted", "field": "isDeleted", "type": "boolean", "required": true },
    { "header": "Deleted Date", "field": "deletedDate", "type": "date", "required": true },
    { "header": "Created Date", "field": "createdDate", "type": "date", "required": true },
    { "header": "Last Activity Date", "field": "lastActivityDate", "type": "date", "required": true },
    { "header": "Item Count", "field": "itemCount", "type": "count", "unit": "items", "required": true },
    { "header": "Storage Used (Byte)", "field": "storageUsedBytes", "type": "bytes", "unit": "bytes", "required": true },
    { "header": "Issue Warning Quota (Byte)", "field": "issueWarningQuotaBytes", "type": "bytes", "unit": "bytes", "required": true },
    { "header": "Prohibit Send Quota (Byte)", "field": "prohibitSendQuotaBytes", "type": "bytes", "unit": "bytes", "required": true },
    { "header": "Prohibit Send/Receive Quota (Byte)", "field": "prohibitSendReceiveQuotaBytes", "type": "bytes", "unit": "bytes", "required": true },
    { "header": "Deleted Item Count", "field": "deletedItemCount", "type": "count", "unit": "items", "required": true },
    { "header": "Deleted Item Size (Byte)", "field": "deletedItemSizeBytes", "type": "bytes", "unit": "bytes", "required": true },
    { "header": "Deleted Item Quota (Byte)", "field": "deletedItemQuotaBytes", "type": "bytes", "unit": "bytes", "required": false },
    { "header": "Has Archive", "field": "hasArchive", "type": "boolean", "required": false },
    { "header": "Report Period", "field": "reportPeriodDays", "type": "days", "unit": "days", "required": true }
  ],
  "relations": [
    { "type": "mailboxOf", "column": "User Principal Name", "direction": "objectToEndpoint", "endpoint": { "type": "user", "namespace": "upn" } }
  ],
  "unsupportedVariants": [
    { "code": "MegabyteUnits", "headers": ["Storage Used (MB)", "Issue Warning Quota (MB)", "Prohibit Send Quota (MB)", "Prohibit Send/Receive Quota (MB)", "Deleted Item Size (MB)"],
      "description": "Microsoft 365 admin center exports in MB are rounded and not byte-faithful; download the Graph CSV in bytes instead." }
  ],
  "coverage": {
    "tenantExhaustive": false,
    "statement": "Rows are the mailboxes Microsoft included in this report snapshot; the file is not a tenant-wide exhaustive mailbox inventory.",
    "limits": [
      { "code": "NotTenantExhaustive", "description": "Missing rows never prove that a mailbox was deleted or never existed." },
      { "code": "ConcealedNames", "description": "When report concealment is enabled, user names are replaced by hashes; such rows or fields are counted and not converted." },
      { "code": "DataLatency", "description": "Microsoft usage reports typically lag 24 to 48 hours; the observation date is the report refresh date, not the upload date." },
      { "code": "DeletedRetention", "description": "Deleted users disappear from usage reports after about 30 days." },
      { "code": "ProvisionalMailboxKey", "description": "Mailboxes are keyed by the report UPN in namespace m365report.upn; Exchange GUIDs are not present in the report." },
      { "code": "OwnerLinkTiming", "description": "Mailbox-to-user links resolve only through an Entra user UPN valid at the report refresh date; otherwise they stay pending." },
      { "code": "NoEndpointFields", "description": "The report carries no Exchange GUID, recipient type, proxy addresses or permissions." }
    ]
  },
  "source": {
    "name": "Microsoft Graph usage report getMailboxUsageDetail (CSV)",
    "endpoints": ["GET https://graph.microsoft.com/v1.0/reports/getMailboxUsageDetail(period='D7') (D7, D30, D90 or D180; 302 redirect to a short-lived CSV download URL)"],
    "cmdlets": ["Get-MgReportMailboxUsageDetail -Period D7 -OutFile mailbox-usage.csv (Microsoft.Graph.Reports)"],
    "permissions": ["Reports.Read.All (Microsoft Graph, delegated or application)"],
    "roles": ["Delegated access: Global Administrator, Exchange Administrator, SharePoint Administrator, Skype for Business (Lync) Administrator, Teams Service Administrator, Teams Communications Administrator or Reports Reader", "Global Reader and Usage Summary Reports Reader see tenant-level summaries only and cannot download user-level detail"],
    "documentation": [
      "https://learn.microsoft.com/graph/api/reportroot-getmailboxusagedetail?view=graph-rest-1.0",
      "https://learn.microsoft.com/microsoft-365/admin/activity-reports/mailbox-usage",
      "https://learn.microsoft.com/microsoft-365/troubleshoot/miscellaneous/reports-show-anonymous-user-name"
    ]
  }
}