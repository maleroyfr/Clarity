{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "environmentKind", "producers", "sections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*$" },
    "version": { "type": "string", "minLength": 1 },
    "environmentKind": { "enum": ["M365Tenant", "AdForest", "AzureScope", "Other"] },
    "producers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "channel", "version", "apiVersion", "preview", "readiness", "testedVersions", "prerequisites", "limits"],
        "properties": {
          "id": { "$ref": "#/$defs/text" },
          "channel": { "enum": ["Graph", "PowerShell", "Import"] },
          "version": { "$ref": "#/$defs/text" },
          "apiVersion": { "$ref": "#/$defs/text" },
          "preview": { "type": "boolean" },
          "readiness": { "enum": ["Planned", "SyntheticValidated"] },
          "testedVersions": { "$ref": "#/$defs/list" },
          "prerequisites": { "$ref": "#/$defs/nonemptyList" },
          "limits": { "$ref": "#/$defs/nonemptyList" }
        }
      }
    },
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "producerIds", "supportedScopes", "attributes", "relations", "permissions", "endpoints", "refreshStrategy", "limits"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-zA-Z][a-zA-Z0-9]*$" },
          "producerIds": { "$ref": "#/$defs/nonemptyList" },
          "supportedScopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["tenant", "forest", "domain", "ou", "resource"] } },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "object", "additionalProperties": false, "required": ["type", "referenceProducer"],
              "properties": {
                "type": { "enum": ["string", "strings", "boolean", "integer", "bytes", "utc", "date"] },
                "referenceProducer": { "$ref": "#/$defs/text" }
              }
            }
          },
          "relations": { "$ref": "#/$defs/list" },
          "permissions": { "$ref": "#/$defs/nonemptyList" },
          "endpoints": { "$ref": "#/$defs/nonemptyList" },
          "refreshStrategy": { "$ref": "#/$defs/text" },
          "limits": { "$ref": "#/$defs/nonemptyList" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "list": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
    "nonemptyList": { "allOf": [{ "$ref": "#/$defs/list" }, { "minItems": 1 }] }
  }
}
