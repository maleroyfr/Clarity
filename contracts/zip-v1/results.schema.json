{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clarity.example/contracts/zip-v1/results.schema.json",
  "type": "array",
  "minItems": 1,
  "maxItems": 1000,
  "items": {
    "type": "object", "additionalProperties": false,
    "required": ["sectionId", "capabilityId", "status", "scope", "coveredFields", "coveredRelations", "warnings", "errors"],
    "properties": {
      "sectionId": { "type": "string", "minLength": 1, "maxLength": 200 },
      "capabilityId": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-zA-Z][a-zA-Z0-9]*$", "maxLength": 100 },
      "status": { "enum": ["Complete", "Partial", "Failed", "NotApplicable"] },
      "scope": {
        "type": "object", "additionalProperties": false, "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["tenant", "forest", "domain", "ou", "resource"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      },
      "coveredFields": { "$ref": "#/$defs/names" },
      "coveredRelations": { "$ref": "#/$defs/names" },
      "objectCount": { "type": ["integer", "null"], "minimum": 0 },
      "relationshipCount": { "type": ["integer", "null"], "minimum": 0 },
      "warnings": { "$ref": "#/$defs/issues" },
      "errors": { "$ref": "#/$defs/issues" }
    },
    "allOf": [
      {
        "if": { "properties": { "status": { "enum": ["Complete", "Partial"] } } },
        "then": {
          "required": ["objectCount", "relationshipCount"],
          "properties": { "objectCount": { "type": "integer" }, "relationshipCount": { "type": "integer" } }
        }
      }
    ]
  },
  "$defs": {
    "names": { "type": "array", "uniqueItems": true, "maxItems": 200, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "issues": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$", "maxLength": 100 },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
