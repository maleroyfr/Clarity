{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clarity.example/contracts/zip-v1/objects.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["sectionId", "type", "namespace", "externalId", "observedAtUtc", "attributes"],
  "properties": {
    "sectionId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "type": { "type": "string", "minLength": 1, "maxLength": 100 },
    "namespace": { "type": "string", "minLength": 1, "maxLength": 100 },
    "externalId": { "type": "string", "minLength": 1, "maxLength": 500 },
    "observedAtUtc": { "type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$" },
    "attributes": {
      "type": "object",
      "maxProperties": 200,
      "propertyNames": { "maxLength": 100 },
      "patternProperties": { "Bytes$": { "type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807 } }
    },
    "alternativeKeys": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["type", "namespace", "externalId"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 100 },
        "namespace": { "type": "string", "minLength": 1, "maxLength": 100 },
        "externalId": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
