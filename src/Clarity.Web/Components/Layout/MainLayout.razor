@inherits LayoutComponentBase
@inject IWebHostEnvironment Environment
@inject IThemeService ThemeService

<a class="skip-link" href="#main-content">@Text["SkipNavigation"]</a>
<FluentLayout NavigationDeferredLoading="true">
    <FluentLayoutItem Area="LayoutArea.Header" Class="masthead" role="banner" Padding="@Padding.Horizontal4">
        <FluentStack VerticalAlignment="VerticalAlignment.Center" Height="100%" HorizontalGap="var(--spacingHorizontalL)">
            <FluentLayoutHamburger IconTitle="@Text["Navigation"]" PanelHeader="@Text["Navigation"]" />
            <FluentLink Href="/" Class="wordmark"><FluentText Size="TextSize.Size500" Weight="TextWeight.Semibold">Clarity</FluentText></FluentLink>
            <FluentSpacer />
            <AuthorizeView><Authorized>
                @if (IsLocal) { <PersonaPicker Current="@context.User.Identity?.Name" /> }
                else { <FluentText Truncate="true">@context.User.Identity?.Name</FluentText> }
            </Authorized></AuthorizeView>
        </FluentStack>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Navigation" Width="224px" Padding="@Padding.All3" Class="navigation-pane">
        <FluentNav aria-label="@Text["Navigation"]" UseIcons="true">
            <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.FolderPeople())">
                @Text["Clients"]
            </FluentNavItem>
        </FluentNav>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Content" Class="workspace">
        <main id="main-content" tabindex="-1">
            @Body
        </main>
    </FluentLayoutItem>
    <FluentLayoutItem Area="LayoutArea.Footer" role="contentinfo" Padding="@Padding.Horizontal4">
        <FluentText Size="TextSize.Size200">@Text["Tagline"]</FluentText>
    </FluentLayoutItem>
</FluentLayout>
<FluentProviders />
<div id="blazor-error-ui" data-nosnippet>
    <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">
        @Text["Error"] <a href="." class="reload">@Text["Reload"]</a>
    </FluentMessageBar>
</div>

@code {
    private bool IsLocal => Environment.IsDevelopment() || Environment.IsEnvironment("Testing");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await ThemeService.SetThemeAsync(ThemeMode.System); }
    }
}
