<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true"><FluentSpinner /></div>
        <p class="components-reconnect-first-attempt-visible">
            @Text["Rejoining"]
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            @Text["RetryIn"] <span id="components-seconds-to-next-attempt"></span> @Text["Seconds"].
        </p>
        <p class="components-reconnect-failed-visible">
            @Text["ReconnectFailed"]
        </p>
        <div class="components-reconnect-failed-visible">
            <FluentButton Id="components-reconnect-button" Appearance="ButtonAppearance.Primary">@Text["Retry"]</FluentButton>
        </div>
        <p class="components-pause-visible">
            @Text["Paused"]
        </p>
        <p class="components-resume-failed-visible">
            @Text["ReconnectFailed"]
        </p>
        <div class="components-pause-visible components-resume-failed-visible">
            <FluentButton Id="components-resume-button" Appearance="ButtonAppearance.Primary">@Text["Resume"]</FluentButton>
        </div>
    </div>
</dialog>
