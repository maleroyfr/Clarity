@page "/projects/{ProjectId:guid}"
@page "/projects/{ProjectId:guid}/{Section}"
@attribute [Authorize]
@inherits FoundationPage
@implements IDisposable
@inject FoundationService Service
@inject NavigationManager Navigation

<PageTitle>@(_project?.Name ?? Text["Projects"]) · Clarity</PageTitle>
@if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
@if (_project is not null)
{
    <nav aria-label="@Text["Breadcrumb"]">
        <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)">
            <FluentLink Href="/">@Text["Clients"]</FluentLink>
            <FluentIcon Value="@(new Icons.Regular.Size12.ChevronRight())" aria-hidden="true" />
            <FluentLink Href="@($"/clients/{_project.WorkspaceId}/projects")">@_clientName · @Text["Projects"]</FluentLink>
        </FluentStack>
    </nav>
    <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)">
        <FluentText As="TextTag.H1" Size="TextSize.Size700" Weight="TextWeight.Semibold">@_project.Name</FluentText>
        <FluentBadge Content="@Text[_project.Scenario.ToString()]" />
        <FluentBadge Content="@Text[_project.Status.ToString()]" />
        <FluentSpacer />
        <FluentSelect TOption="EnvironmentRole" TValue="EnvironmentRole" Items="Enum.GetValues<EnvironmentRole>()" OptionText="@(role => Text[role.ToString()])" Value="_side" ValueChanged="ChangeSide" Label="@Text["ActiveSide"]" />
    </FluentStack>
    @if (!string.IsNullOrEmpty(_project.Description)) { <p>@_project.Description</p> }
    <FluentTabs Overflow="true" ActiveTabId="@(Section ?? "overview")" ActiveTabIdChanged="ChangeSection" aria-label="@Text["Projects"]">
        @foreach (var section in Sections)
        {
            <FluentTab Id="@section.Key" Header="@Text[section.Value]">
                @if (section.Key == (Section ?? "overview")) { @SectionContent }
            </FluentTab>
        }
    </FluentTabs>
    @if (Section is not null && !Sections.ContainsKey(Section))
    {
        <EmptyState Title="@Text["NotFound"]" Description="@Text["LaterLot"]">
            <FluentLink Href="@($"/projects/{ProjectId}/discovery")">@Text["Discovery"]</FluentLink>
        </EmptyState>
    }
}

@code {
    private RenderFragment SectionContent => @<div class="section-content">
    @if (Section == "discovery")
    {
        <DiscoveryPanel ProjectId="ProjectId" Side="_side" InitialView="@DiscoveryView" />
    }
    else if (Section == "inventory")
    {
        <nav aria-label="@Text["Inventory"]"><FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalL)">
            <SectionLink Href="@($"/projects/{ProjectId}/inventory?side={_side}")" Active="@(DiscoveryView is not ("Mappings" or "PendingLinks"))">@Text["Inventory"]</SectionLink>
            <SectionLink Href="@($"/projects/{ProjectId}/inventory?side={_side}&view=Mappings")" Active="@(DiscoveryView == "Mappings")">@Text["MappingReview"]</SectionLink>
            <SectionLink Href="@($"/projects/{ProjectId}/inventory?side={_side}&view=PendingLinks")" Active="@(DiscoveryView == "PendingLinks")">@Text["PendingLinks"]</SectionLink>
        </FluentStack></nav>
        @if (DiscoveryView == "Mappings")
        { <MappingPanel @key="(ProjectId, _side)" ProjectId="ProjectId" Side="_side" /> }
        else if (DiscoveryView == "PendingLinks")
        { <PendingLinks @key="(ProjectId, _side)" ProjectId="ProjectId" Side="_side" /> }
        else
        { <InventoryPanel @key="(ProjectId, _side)" ProjectId="ProjectId" Side="_side" /> }
    }
    else if (Section is null or "overview")
    {
        <p>@Text["TargetPresence"] : <FluentLink Href="@($"/projects/{ProjectId}/overview?side=Target")">@Text[_environments.Any(x => x.Role == EnvironmentRole.Target) ? "Present" : "Absent"]</FluentLink></p>
        <ScenarioPanel @key="ProjectId" ProjectId="ProjectId" Revision="_environments.Count" />
        <OverviewPanel @key="(ProjectId, _side)" ProjectId="ProjectId" Side="_side" />
        <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)"><FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold" Block="true">@Text["Environments"] · @Text[_side.ToString()]</FluentText>
            <FluentButton OnClick="OpenEnvironment">@Text[_side == EnvironmentRole.Source ? "AddSource" : "AddTarget"]</FluentButton></FluentStack>
        @if (!_environments.Any(x => x.Role == _side))
        {
            <EmptyState Title="@Text[_side == EnvironmentRole.Source ? "NoSource" : "AddTarget"]" Description="@Text["NoSourceHint"]">
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="OpenEnvironment">@Text[_side == EnvironmentRole.Source ? "AddSource" : "AddTarget"]</FluentButton>
            </EmptyState>
        }
        @foreach (var environment in _environments.Where(x => x.Role == _side))
        {
            <FluentCard>
                <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text[environment.Kind.ToString()] · @Text[environment.Role.ToString()]</FluentText>
                <p>@environment.ExternalId</p><p>@Text["DeclaredScope"] : @environment.DeclaredScope</p>
                <p>@Text[environment.TargetState.ToString()] · @environment.Hypotheses</p>
            </FluentCard>
        }
        <p><FluentLink Href="@($"/projects/{ProjectId}/discovery?side={_side}")">@Text["ViewCollections"]</FluentLink></p>
    }
    else if (Section == "scope")
    {
        <ScopePanel @key="(ProjectId, _side, DiscoveryView)" ProjectId="ProjectId" Side="_side" View="@DiscoveryView" />
    }
    else if (Section == "comparison")
    {
        <ComparisonPanel @key="(ProjectId, _side, DiscoveryView)" ProjectId="ProjectId" Side="_side" View="@DiscoveryView" />
    }
    else if (Section == "exports")
    {
        <ExportPanel @key="(ProjectId, _side)" ProjectId="ProjectId" Side="_side" />
    }
    </div>;
}
@if (_addEnvironment)
{
    <DetailPanel Title="@Text["AddEnvironment"]" Error="@Error" Close="@(() => _addEnvironment = false)">
        <form @onsubmit="AddEnvironmentAsync" @onsubmit:preventDefault>
            <FluentSelect TOption="EnvironmentRole" TValue="EnvironmentRole" Items="Enum.GetValues<EnvironmentRole>()" OptionText="@(role => Text[role.ToString()])" @bind-Value="_role" Label="@Text["Role"]" />
            <FluentSelect TOption="EnvironmentKind" TValue="EnvironmentKind" Items="Enum.GetValues<EnvironmentKind>()" OptionText="@(kind => Text[kind.ToString()])" @bind-Value="_kind" Label="@Text["Kind"]" />
            @if (_role == EnvironmentRole.Target)
            {
                <FluentSelect TOption="TargetState" TValue="TargetState" Items="Enum.GetValues<TargetState>()" OptionText="@(state => Text[state.ToString()])" @bind-Value="_targetState" Label="@Text["TargetState"]" />
            }
            <FluentTextInput Label="@Text["ExternalId"]" @bind-Value="_externalId" />
            <FluentTextInput Label="@Text["DeclaredScope"]" @bind-Value="_declaredScope" />
            <FluentTextInput Label="@Text["Hypotheses"]" @bind-Value="_hypotheses" />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="Busy">@Text["Save"]</FluentButton>
        </form>
    </DetailPanel>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string? Section { get; set; }
    [SupplyParameterFromQuery(Name = "view")] public string? DiscoveryView { get; set; }
    [SupplyParameterFromQuery(Name = "side")] public string? SideQuery { get; set; }
    private void ChangeSide(EnvironmentRole side) => Navigation.NavigateTo($"/projects/{ProjectId}/{Section ?? "overview"}?side={side}");
    private void ChangeSection(string? section)
    {
        // FluentTabs also reports selection changes while removing tabs, including during SSR teardown.
        if (RendererInfo.IsInteractive && !_disposed && _project is not null
            && section is not null && Sections.ContainsKey(section) && section != (Section ?? "overview"))
        {
            Navigation.NavigateTo($"/projects/{ProjectId}/{section}{(_side == EnvironmentRole.Target ? "?side=Target" : "")}");
        }
    }
    private bool _disposed;
    public void Dispose() => _disposed = true;
    private static readonly Dictionary<string, string> Sections = new()
    {
        ["overview"] = "Overview", ["discovery"] = "Discovery", ["inventory"] = "Inventory",
        ["scope"] = "Scope", ["comparison"] = "Comparison", ["exports"] = "Exports"
    };
    private Project? _project;
    private string _clientName = "";
    private IReadOnlyList<ProjectEnvironment> _environments = [];
    private EnvironmentRole _side, _role;
    private EnvironmentKind _kind;
    private TargetState _targetState = TargetState.Existing;
    private bool _addEnvironment;
    private string _externalId = "", _declaredScope = "", _hypotheses = "";
    private Guid _operationId = Guid.NewGuid();

    protected override Task OnParametersSetAsync()
    {
        _side = SideQuery == "Target" ? EnvironmentRole.Target : EnvironmentRole.Source;
        return RunAsync(LoadAsync);
    }
    private async Task LoadAsync()
    {
        _project = null;
        var project = await Service.GetProjectAsync(ProjectId);
        _clientName = (await Service.GetWorkspaceAsync(project.WorkspaceId)).Name;
        _environments = await Service.ListEnvironmentsAsync(ProjectId);
        _project = project;
    }
    private void OpenEnvironment() { _role = _side; _addEnvironment = true; }
    private Task AddEnvironmentAsync() => RunAsync(async () =>
    {
        await Service.AddEnvironmentAsync(ProjectId, _operationId, _role, _kind, _externalId, _declaredScope,
            _role == EnvironmentRole.Source ? TargetState.Existing : _targetState, _hypotheses);
        _side = _role; _addEnvironment = false; _externalId = ""; _declaredScope = ""; _hypotheses = "";
        _operationId = Guid.NewGuid(); await LoadAsync();
    });
}
