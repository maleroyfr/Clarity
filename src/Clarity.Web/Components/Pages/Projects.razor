@page "/clients/{WorkspaceId:guid}/projects"
@attribute [Authorize]
@inherits FoundationPage
@using Clarity.Infrastructure
@inject FoundationService Service
@inject INotificationService Notifications
@inject ProjectDeletionService Deletion
@inject RetentionOptions Retention

<PageTitle>@Text["Projects"] · Clarity</PageTitle>
<nav aria-label="@Text["Breadcrumb"]"><FluentLink Href="/">@Text["Clients"]</FluentLink></nav>
<FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)">
    <FluentText As="TextTag.H1" Size="TextSize.Size700" Weight="TextWeight.Semibold">@Text["Projects"]</FluentText>
    <FluentSpacer />
    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => _create = true)">@Text["NewProject"]</FluentButton>
</FluentStack>
@if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
<FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="var(--spacingHorizontalM)">
    <FluentTextInput TextInputType="TextInputType.Search" Label="@Text["Search"]" @bind-Value="_search" />
    <FluentButton OnClick="SearchAsync">@Text["SearchAction"]</FluentButton>
</FluentStack>
<ClarityGrid TGridItem="Project" @key="WorkspaceId" Load="LoadAsync" Search="@_search" @ref="_grid">
    <Columns>
        <PropertyColumn Property="@(x => x.Name)" Title="@Text["Name"]" Sortable="true" />
        <TemplateColumn Title="@Text["Scenario"]">@Text[context.Scenario.ToString()]</TemplateColumn>
        <TemplateColumn Title="@Text["Status"]"><FluentBadge Content="@Text[context.Status.ToString()]" />@if (Retention.DeletionDue(context, DateTimeOffset.UtcNow)) { <FluentBadge Content="@Text["DeletionDue"]" /> }</TemplateColumn>
        <TemplateColumn Title="@Text["LastInventory"]">@Text["NoInventory"]</TemplateColumn>
        <TemplateColumn Title="@Text["SectionsToVerify"]">@Text["Unknown"]</TemplateColumn>
        <TemplateColumn Title="@Text["TargetPresence"]">@Text["Unknown"]</TemplateColumn>
        <TemplateColumn Title="@Text["Overview"]">@if (context.Status == ProjectStatus.Deleting) { <FluentText>@Text["Deleting"]</FluentText> } else { <FluentLink Href="@($"/projects/{context.Id}")">@Text["Overview"]</FluentLink> }</TemplateColumn>
        <TemplateColumn Title="@Text["Archive"]"><FluentButton Disabled="@(context.Status != ProjectStatus.Active)" OnClick="@(() => _archive = context.Id)">@Text["Archive"]</FluentButton></TemplateColumn>
        <TemplateColumn Title="@Text["DeleteProject"]"><FluentButton Disabled="@(context.Status == ProjectStatus.Active)" OnClick="@(() => { _delete = context; _confirmation = ""; })">@Text["DeleteProject"]</FluentButton></TemplateColumn>
    </Columns>
    <EmptyContent><EmptyState Title="@Text["NoProjects"]" Description="@Text["NoProjectsHint"]"><FluentButton OnClick="@(() => _create = true)">@Text["NewProject"]</FluentButton></EmptyState></EmptyContent>
</ClarityGrid>
@if (_create)
{
    <DetailPanel Title="@Text["NewProject"]" Error="@Error" Close="@(() => _create = false)">
        <form @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <FluentTextInput Label="@Text["Name"]" Required="true" @bind-Value="_name" />
            <FluentSelect TOption="ProjectScenario" TValue="ProjectScenario" Items="Enum.GetValues<ProjectScenario>()" OptionText="@(scenario => Text[scenario.ToString()])" @bind-Value="_scenario" Label="@Text["Scenario"]" />
            <FluentTextInput Label="@Text["Description"]" @bind-Value="_description" />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="Busy">@Text["Save"]</FluentButton>
        </form>
    </DetailPanel>
}
@if (_archive is not null)
{
    <DetailPanel Title="@Text["Archive"]" Error="@Error" Close="@(() => _archive = null)">
        <p>@Text["ArchiveConfirm"]</p><FluentButton Disabled="Busy" OnClick="ArchiveAsync">@Text["Archive"]</FluentButton>
    </DetailPanel>
}
@if (_delete is not null)
{
    <DetailPanel Title="@Text["DeleteProject"]" Error="@Error" Close="@(() => _delete = null)">
        <FluentMessageBar Intent="MessageBarIntent.Warning" AllowDismiss="false">@Text["DeleteConfirm"]</FluentMessageBar>
        <form @onsubmit="DeleteAsync" @onsubmit:preventDefault>
            <FluentTextInput Label="@Text["DeleteConfirmName"]" Required="true" @bind-Value="_confirmation" />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="@(Busy || _confirmation != _delete.Name)">@Text["DeleteProject"]</FluentButton>
        </form>
    </DetailPanel>
}

@code {
    [Parameter] public Guid WorkspaceId { get; set; }
    private string _search = "", _name = "", _description = "";
    private ProjectScenario _scenario = ProjectScenario.AuditOnly;
    private bool _create;
    private Guid _operationId = Guid.NewGuid();
    private Guid? _archive;
    private Project? _delete;
    private string _confirmation = "";
    private ClarityGrid<Project>? _grid;
    private Task<PageResult<Project>> LoadAsync(PageRequest request, CancellationToken ct) => Service.ListProjectsAsync(WorkspaceId, request, ct);
    private Task SearchAsync() => _grid?.RefreshAsync() ?? Task.CompletedTask;
    private Task CreateAsync() => RunAsync(async () =>
    {
        await Service.CreateProjectAsync(WorkspaceId, _operationId, _name, _scenario, _description);
        _create = false; _name = ""; _description = ""; _operationId = Guid.NewGuid(); await SearchAsync();
        await Notifications.ShowSuccessToastAsync(Text["ChangesSaved"]);
    });
    private Task ArchiveAsync() => RunAsync(async () =>
    {
        await Service.ArchiveProjectAsync(_archive!.Value); _archive = null; await SearchAsync();
    });
    private Task DeleteAsync() => RunAsync(async () =>
    {
        await Deletion.RequestAsync(_delete!.Id, _confirmation); _delete = null; await SearchAsync();
    });
}
