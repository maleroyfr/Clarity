@page "/"
@attribute [Authorize]
@inherits FoundationPage
@inject FoundationService Service
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment

<PageTitle>@Text["Clients"] · Clarity</PageTitle>
<div class="page-heading"><div><p class="eyebrow">CLARITY</p><h1>@Text["Clients"]</h1><p>@Text["ClientIntro"]</p></div>
    <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!Configured)" OnClick="@(() => _create = true)">@Text["NewClient"]</FluentButton>
</div>
@if (Error is not null) { <p role="alert" class="error">@Error</p> }
@if (!Configured)
{
    <p role="status" class="notice">@Text["SqlRequired"]</p>
    <EmptyState Title="@Text["NoClients"]" Description="@Text["NoClientsHint"]" />
}
else
{
    <div class="toolbar"><FluentTextInput Label="@Text["Search"]" @bind-Value="_search" />
        <FluentButton OnClick="SearchAsync">@Text["SearchAction"]</FluentButton></div>
    <ClarityGrid TGridItem="ClientWorkspace" Load="LoadAsync" Search="_search" @ref="_grid">
        <Columns>
            <PropertyColumn Property="@(x => x.Name)" Title="@Text["Name"]" Sortable="true" />
            <TemplateColumn Title="@Text["Status"]">@Text[context.Status.ToString()]</TemplateColumn>
            <TemplateColumn Title="@Text["Projects"]"><a href="@($"/clients/{context.Id}/projects")">@Text["Projects"]</a></TemplateColumn>
            <TemplateColumn Title="@Text["ManageMembers"]"><FluentButton OnClick="@(() => _memberWorkspace = context.Id)">@Text["ManageMembers"]</FluentButton></TemplateColumn>
            <TemplateColumn Title="@Text["Archive"]"><FluentButton Disabled="@(context.Status == WorkspaceStatus.Archived)" OnClick="@(() => _archive = context.Id)">@Text["Archive"]</FluentButton></TemplateColumn>
        </Columns>
        <EmptyContent><EmptyState Title="@Text["NoClients"]" Description="@Text["NoClientsHint"]" /></EmptyContent>
    </ClarityGrid>
}
@if (_create)
{
    <DetailPanel Title="@Text["NewClient"]" Error="@Error" Close="@(() => _create = false)">
        <form @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <FluentTextInput Label="@Text["Name"]" Required="true" @bind-Value="_name" />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="Busy">@Text["Save"]</FluentButton>
        </form>
    </DetailPanel>
}
@if (_archive is not null)
{
    <DetailPanel Title="@Text["Archive"]" Error="@Error" Close="@(() => _archive = null)">
        <p>@Text["ArchiveConfirm"]</p><FluentButton Disabled="Busy" OnClick="ArchiveAsync">@Text["Archive"]</FluentButton>
    </DetailPanel>
}
@if (_memberWorkspace is not null)
{
    <DetailPanel Title="@Text["ManageMembers"]" Error="@Error" Close="@(() => _memberWorkspace = null)">
        <form @onsubmit="SetMemberAsync" @onsubmit:preventDefault>
            <FluentTextInput Label="@Text["TenantId"]" Required="true" @bind-Value="_tenantId" />
            <FluentTextInput Label="@Text["ObjectId"]" Required="true" @bind-Value="_objectId" />
            <FluentSelect TOption="WorkspaceRole" TValue="WorkspaceRole" Items="Enum.GetValues<WorkspaceRole>()" OptionText="@(role => Text[role.ToString()])" @bind-Value="_role" Label="@Text["Role"]" />
            <FluentButton Type="ButtonType.Submit" Disabled="Busy">@Text["Save"]</FluentButton>
        </form>
    </DetailPanel>
}

@code {
    private bool Configured => !Environment.IsDevelopment() || !string.IsNullOrWhiteSpace(Configuration.GetConnectionString("Clarity"));
    private string _search = "", _name = "", _tenantId = "", _objectId = "";
    private bool _create;
    private Guid _operationId = Guid.NewGuid();
    private Guid? _archive, _memberWorkspace;
    private WorkspaceRole _role = WorkspaceRole.WorkspaceManager;
    private ClarityGrid<ClientWorkspace>? _grid;
    private Task<PageResult<ClientWorkspace>> LoadAsync(PageRequest request, CancellationToken ct) => Service.ListWorkspacesAsync(request, ct);
    private Task SearchAsync() => _grid?.RefreshAsync() ?? Task.CompletedTask;
    private Task CreateAsync() => RunAsync(async () =>
    {
        await Service.CreateWorkspaceAsync(_operationId, _name);
        _create = false; _name = ""; _operationId = Guid.NewGuid(); await SearchAsync();
    });
    private Task ArchiveAsync() => RunAsync(async () =>
    {
        await Service.ArchiveWorkspaceAsync(_archive!.Value); _archive = null; await SearchAsync();
    });
    private Task SetMemberAsync() => RunAsync(async () =>
    {
        if (!Guid.TryParse(_tenantId, out var tenant) || !Guid.TryParse(_objectId, out var subject)) { throw new ArgumentException("Invalid identity."); }
        await Service.SetMemberAsync(_memberWorkspace!.Value, new(tenant, subject), _role);
        _memberWorkspace = null; await SearchAsync();
    });
}
