@page "/"
@attribute [Authorize]
@inherits FoundationPage
@inject FoundationService Service
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject WorkspaceAuthorization Authorization

<PageTitle>@Text["Clients"] · Clarity</PageTitle>
<FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)">
    <FluentText As="TextTag.H1" Size="TextSize.Size700" Weight="TextWeight.Semibold">@Text["Clients"]</FluentText>
    <FluentSpacer />
    @if (IsPlatformAdmin)
    { <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@(() => _create = true)">@Text["NewClient"]</FluentButton> }
</FluentStack>
<p>@Text["ClientIntro"]</p>
@if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
@if (!Configured)
{
    <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["SqlRequired"]</FluentMessageBar>
}
else
{
    <DirectorySearch @bind-Value="_search" />
    <ClarityGrid TGridItem="ClientWorkspace" @key="_search" Load="LoadAsync" Search="@_search" @ref="_grid">
        <Columns>
            <PropertyColumn Property="@(x => x.Name)" Title="@Text["Name"]" Sortable="true" />
            <TemplateColumn Title="@Text["Status"]"><FluentBadge Content="@Text[context.Status.ToString()]" /></TemplateColumn>
            <TemplateColumn Title="@Text["Actions"]">
                <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalS)">
                    @if (Authorization.Allows(context.Id, WorkspaceOperation.Read))
                    { <FluentLink Href="@($"/clients/{context.Id}/projects")">@Text["Projects"]</FluentLink> }
                    @if (context.Status == WorkspaceStatus.Active && (IsPlatformAdmin || Authorization.Allows(context.Id, WorkspaceOperation.ManageMembers)))
                    { <FluentButton OnClick="@(() => _memberWorkspace = context)">@Text["ManageMembers"]</FluentButton> }
                    @if (context.Status == WorkspaceStatus.Active && IsPlatformAdmin)
                    { <FluentButton OnClick="@(() => _archive = context)">@Text["Archive"]</FluentButton> }
                </FluentStack>
            </TemplateColumn>
        </Columns>
        <EmptyContent>
            @if (_search.Length == 0) { <EmptyState Title="@Text["NoClients"]" Description="@Text["NoClientsHint"]" /> }
            else { <p>@Text["NoResults"]</p> }
        </EmptyContent>
    </ClarityGrid>
}
@if (_create)
{
    <DetailPanel Title="@Text["NewClient"]" Error="@Error" Close="@(() => _create = false)">
        <form @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <FluentTextInput Label="@Text["Name"]" Required="true" @bind-Value="_name" />
            <FluentButton Type="ButtonType.Submit" Appearance="ButtonAppearance.Primary" Disabled="Busy">@Text["Save"]</FluentButton>
        </form>
    </DetailPanel>
}
@if (_archive is not null)
{
    <DetailPanel Title="@Text["ArchiveNamed", _archive.Name]" Error="@Error" Close="@(() => _archive = null)">
        <p>@Text["ArchiveWorkspaceHint"]</p><FluentButton Disabled="Busy" OnClick="ArchiveAsync">@Text["Archive"]</FluentButton>
    </DetailPanel>
}
@if (_memberWorkspace is not null)
{
    <DetailPanel Title="@($"{Text["ManageMembers"]} · {_memberWorkspace.Name}")" Error="@Error" Close="@(() => _memberWorkspace = null)">
        <form @onsubmit="SetMemberAsync" @onsubmit:preventDefault>
            <FluentTextInput Label="@Text["TenantId"]" Required="true" @bind-Value="_tenantId" />
            <FluentTextInput Label="@Text["ObjectId"]" Required="true" @bind-Value="_objectId" />
            <FluentSelect TOption="WorkspaceRole" TValue="WorkspaceRole" Items="Enum.GetValues<WorkspaceRole>()" OptionText="@(role => Text[role.ToString()])" @bind-Value="_role" Label="@Text["Role"]" />
            <FluentButton Type="ButtonType.Submit" Disabled="Busy">@Text["Save"]</FluentButton>
        </form>
    </DetailPanel>
}

@code {
    private bool Configured => !Environment.IsDevelopment() || !string.IsNullOrWhiteSpace(Configuration.GetConnectionString("Clarity"));
    private string _search = "", _name = "", _tenantId = "", _objectId = "";
    private bool _create;
    private Guid _operationId = Guid.NewGuid();
    private ClientWorkspace? _archive, _memberWorkspace;
    private bool IsPlatformAdmin => Authorization.Allows(Guid.Empty, WorkspaceOperation.AdministerPlatform);
    protected override Task OnInitializedAsync() => Configured ? RunAsync(() => Authorization.RefreshAsync()) : Task.CompletedTask;
    private WorkspaceRole _role = WorkspaceRole.WorkspaceManager;
    private ClarityGrid<ClientWorkspace>? _grid;
    private Task<PageResult<ClientWorkspace>> LoadAsync(PageRequest request, CancellationToken ct) => Service.ListWorkspacesAsync(request, ct);
    private Task RefreshAsync() => _grid?.RefreshAsync() ?? Task.CompletedTask;
    private Task CreateAsync() => RunAsync(async () =>
    {
        await Service.CreateWorkspaceAsync(_operationId, _name);
        _create = false; _name = ""; _operationId = Guid.NewGuid(); await RefreshAsync();
    });
    private Task ArchiveAsync() => RunAsync(async () =>
    {
        await Service.ArchiveWorkspaceAsync(_archive!.Id); _archive = null; await RefreshAsync();
    });
    private Task SetMemberAsync() => RunAsync(async () =>
    {
        if (!Guid.TryParse(_tenantId, out var tenant) || !Guid.TryParse(_objectId, out var subject)) { throw new ArgumentException("Invalid identity."); }
        await Service.SetMemberAsync(_memberWorkspace!.Id, new(tenant, subject), _role);
        _memberWorkspace = null; await RefreshAsync();
    });
}
