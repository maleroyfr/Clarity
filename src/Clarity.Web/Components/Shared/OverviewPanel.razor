@using Clarity.Contracts
@using Clarity.Infrastructure
@using Microsoft.AspNetCore.WebUtilities
@inherits FoundationPage
@inject InventoryOverview Overview

@if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
@if (_data is { } data)
{
    @if (!data.HasObservations)
    {
        <EmptyState Title="@Text["NoInventory"]" Description="@Text["OverviewEmptyHint"]">
            <FluentLink Href="@DiscoveryLink">@Text["ViewCollections"]</FluentLink>
        </EmptyState>
    }
    <div class="summary-cards">
        @foreach (var metric in data.Metrics)
        {
            <FluentCard><FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text[metric.Label]</FluentText>
                @if (metric.Amount.HasValue)
                {
                    <FluentLink Href="@InventoryLink(metric.Filter)">@metric.Amount.Value.ToString("N0")</FluentLink>
                    @if (metric.KnownResources.HasValue) { <small>@Text["KnownSubscriptions"] : @metric.KnownResources / @metric.ObservedResources</small> }
                }
                else { <p>@Text["Unknown"] · <FluentLink Href="@DiscoveryLink">@Text["Coverage"]</FluentLink></p> }
            </FluentCard>
        }
        <FluentCard><FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["MappingReview"]</FluentText><FluentLink Href="@($"/projects/{ProjectId}/inventory?view=Mappings&side={Side}&state=Queue")">@data.ReviewCount</FluentLink></FluentCard>
        <FluentCard><FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["PendingLinks"]</FluentText><FluentLink Href="@($"/projects/{ProjectId}/inventory?view=PendingLinks&side={Side}")">@data.PendingLinks</FluentLink></FluentCard>
    </div>
    @if (data.Units.Count > 0)
    {
        <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["InventoryDatesCoverage"]</FluentText>
        @foreach (var unit in data.Units)
        {
            var scope = System.Text.Json.JsonSerializer.Deserialize<CollectionScope>(unit.ScopeJson, ContractJson.Options)!;
            <FluentCard><strong>@unit.Environment · @Text[$"Section_{unit.Capability}"]</strong>
                <p>@Text[$"ScopeKind_{scope.Kind}"] : @scope.Value · @Text[unit.Status.ToString()]</p>
                <FluentLink Href="@InventoryLink(new(Side, unit.EnvironmentId, Run: unit.RunId, Section: unit.SectionId))">@unit.Date.ToString("u") · @Text["SectionObjects"]</FluentLink>
                <FluentButton OnClick="@(() => _proof = new(ProofKind.Section, unit.SectionId))">@Text["Provenance"]</FluentButton>
            </FluentCard>
        }
        <FluentLink Href="@DiscoveryLink">@Text["Coverage"]</FluentLink>
    }
    @if (data.Changes.Count > 0)
    {
        <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["RecentChanges"]</FluentText>
        <ul>@foreach (var change in data.Changes)
            {
                <li><FluentLink Href="@($"/projects/{ProjectId}/inventory?side={Side}&object={change.Id}")">@change.Label</FluentLink> · @change.Changed?.ToString("u")</li>
            }</ul>
    }
}
@if (_proof is not null)
{
    <ProvenancePanel ProjectId="ProjectId" Target="_proof" Close="@(() => _proof = null)" />
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EnvironmentRole Side { get; set; }
    private OverviewData? _data;
    private ProofRef? _proof;
    private string DiscoveryLink => $"/projects/{ProjectId}/discovery?side={Side}&view=Coverage";
    private string InventoryLink(InventoryFilter f) => QueryHelpers.AddQueryString($"/projects/{ProjectId}/inventory", new Dictionary<string, string?>
    {
        ["side"] = f.Side.ToString(), ["population"] = f.Population ? "true" : null, ["conflicts"] = f.ConflictsOnly ? "true" : null,
        ["unresolved"] = f.Unresolved ? "true" : null, ["volume"] = f.Volume, ["type"] = f.Type, ["environment"] = f.Environment?.ToString(),
        ["run"] = f.Run?.ToString(), ["sectionId"] = f.Section?.ToString()
    });
    protected override Task OnParametersSetAsync() => RunAsync(async () => { _data = null; _proof = null; _data = await Overview.ReadAsync(ProjectId, Side); });
}
