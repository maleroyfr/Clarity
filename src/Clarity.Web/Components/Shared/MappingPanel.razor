@using Clarity.Infrastructure
@inherits FoundationPage
@inject MappingReview Review
@inject InventoryMatching Matching
@inject FoundationService Foundation
@inject WorkspaceAuthorization Authorization
@inject NavigationManager Navigation

<section aria-label="@Text["MappingReview"]">
    @if (Kind == MappingKind.Hybrid) { <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold" Block="true">@Text["MappingReview"] · @Text[Side.ToString()]</FluentText> }
    else { <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["SourceTargetMappings"]</FluentText> }
    @if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
    @if (_message is not null) { <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false">@_message</FluentMessageBar> }
    <FluentSelect TOption="string" TValue="string" Label="@Text["Status"]" Items="States"
                  OptionText="@(s => Text[s])" Value="@_state" ValueChanged="ChangeState" />
    <ClarityGrid @key="(ProjectId, Kind, Side, _state, _revision)" TGridItem="MappingRow" Load="@((p, ct) => Review.PageAsync(ProjectId, Kind, Side, _state, p, ct))">
        <Columns>
            <TemplateColumn Title="@Text["SelectAssociation"]" Context="r">
                <FluentCheckbox AriaLabel="@($"{Text["SelectAssociation"]} : {r.AdLabel} / {r.EntraLabel}")" Disabled="@(!_canQualify || Busy)"
                        Value="@_selected.ContainsKey(r.Id)" ValueChanged="@(selected => Select(r, selected))" />
            </TemplateColumn>
            <TemplateColumn Title="@(Kind == MappingKind.Hybrid ? "AD" : Text["Source"].Value)" Context="r">
                <FluentLink Href="@Sheet(r.AdId, Kind == MappingKind.Hybrid ? Side : EnvironmentRole.Source)">@r.AdLabel</FluentLink><small>@r.Forest</small></TemplateColumn>
            <TemplateColumn Title="@(Kind == MappingKind.Hybrid ? "Entra" : Text["Target"].Value)" Context="r">
                <FluentLink Href="@Sheet(r.EntraId, Kind == MappingKind.Hybrid ? Side : EnvironmentRole.Target)">@r.EntraLabel</FluentLink><small>@r.Tenant</small></TemplateColumn>
            <TemplateColumn Title="@Text["Status"]" Context="r">@Text[r.State.ToString()] · @Text[r.Rule.ToString()]</TemplateColumn>
            <TemplateColumn Title="@Text["Actions"]" Context="r">
                <FluentButton OnClick="@(() => _proof = new(ProofKind.Mapping, r.Id))">@Text["Provenance"]</FluentButton>
                @if (_canQualify && Kind == MappingKind.Hybrid) { <FluentButton OnClick="@(() => BeginCorrection(r))">@Text["CorrectAssociation"]</FluentButton> }
            </TemplateColumn>
        </Columns>
        <EmptyContent>
            @if (Kind == MappingKind.Hybrid) { <p>@Text["NoMappings"] <FluentLink Href="@($"/projects/{ProjectId}/discovery?side={Side}")">Discovery</FluentLink></p> }
            else { <p>@Text["NoSourceTargetMappings"]</p> }
        </EmptyContent>
    </ClarityGrid>
    @if (_canQualify)
    {
        <FluentTextInput Label="@Text["Justification"]" @bind-Value="_reason" />
        <FluentButton OnClick="@(() => PreviewAsync(true))" Disabled="@(_selected.Count == 0 || Busy)">@Text["PreviewValidate"]</FluentButton>
        <FluentButton OnClick="@(() => PreviewAsync(false))" Disabled="@(_selected.Count == 0 || Busy)">@Text["PreviewReject"]</FluentButton>
        @if (_batch is { } batch)
        {
            <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["AffectedAssociations"] : @batch.Count · @Text[batch.Validate ? "Validated" : "Rejected"]</FluentMessageBar>
            <FluentButton OnClick="ApplyAsync" Disabled="@(Busy || batch.Count == 0 || string.IsNullOrWhiteSpace(_reason))">@Text["ConfirmDecisions"]</FluentButton>
        }
        @if (_original is { } original)
        {
            <FluentCard><FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["CorrectAssociation"]</FluentText><p>@original.AdLabel → @original.EntraLabel</p>
                <FluentTextInput Label="@Text["ReplacementEntra"]" @bind-Value="_replacement" />
                <FluentButton OnClick="PreviewCorrectionAsync">@Text["Preview"]</FluentButton>
                @if (_correction is { } correction && _replacement == correction.ReplacementId.ToString())
                {
                    <p>@Text["ReplacementPreview"] : @original.AdLabel → @correction.ReplacementLabel</p>
                    <FluentButton OnClick="CorrectAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_reason))">@Text["ConfirmCorrection"]</FluentButton>
                }
            </FluentCard>
        }
        @if (Kind == MappingKind.Hybrid && _forests.Count != 0 && _tenants.Count != 0)
        {
            <FluentAccordion><FluentAccordionItem Header="@Text["VerifySourceAnchor"]">
                <p>@Text["AnchorHint"]</p>
                <FluentSelect TOption="ProjectEnvironment" TValue="Guid" Label="@Text["AD"]" Items="_forests"
                              OptionText="@(e => e.ExternalId)" OptionValue="@(e => e.Id)" @bind-Value="_forest" @bind-Value:after="LoadBindingAsync" />
                <FluentSelect TOption="ProjectEnvironment" TValue="Guid" Label="@Text["Entra"]" Items="_tenants"
                              OptionText="@(e => e.ExternalId)" OptionValue="@(e => e.Id)" @bind-Value="_tenant" @bind-Value:after="LoadBindingAsync" />
                @if (_binding != null) { <p>@_binding.VerifiedAtUtc.ToString("u") · @_binding.VerifiedByObjectId · @_binding.Reason</p> }
                <FluentSelect TOption="string" TValue="string" Label="@Text["sourceAnchor"]" @bind-Value="_anchor">
                    <FluentOption TValue="string" Value="@string.Empty">@Text["Unverified"]</FluentOption>
                    <FluentOption TValue="string" Value="@("ObjectGuid")">objectGUID</FluentOption>
                    <FluentOption TValue="string" Value="@("ConsistencyGuid")">mS-DS-ConsistencyGuid</FluentOption>
                </FluentSelect>
                <FluentTextInput Label="@Text["AnchorEvidence"]" @bind-Value="_anchorReason" />
                <FluentButton OnClick="VerifyAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_anchorReason))">@Text["Save"]</FluentButton>
            </FluentAccordionItem></FluentAccordion>
        }
    }
</section>
@if (_proof is not null)
{
    <ProvenancePanel @key="(ProjectId, _proof)" ProjectId="ProjectId" Target="_proof" Close="@(() => _proof = null)" />
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EnvironmentRole Side { get; set; }
    [Parameter] public MappingKind Kind { get; set; } = MappingKind.Hybrid;
    [SupplyParameterFromQuery(Name = "state")] public string? State { get; set; }
    private static readonly string[] States = ["Queue", "Proposed", "ToReview", "Validated", "Rejected", "All"];
    private readonly Dictionary<Guid, MappingSelection> _selected = [];
    private (MappingSelection[] Selection, bool Validate, int Count)? _batch;
    private MappingRow? _original;
    private CorrectionPreview? _correction;
    private ProofRef? _proof;
    private SyncBinding? _binding;
    private string _state = "Queue", _reason = "", _replacement = "", _anchor = "", _anchorReason = "";
    private string? _message;
    private bool _canQualify;
    private int _revision;
    private IReadOnlyList<ProjectEnvironment> _forests = [], _tenants = [];
    private Guid _forest, _tenant;
    protected override Task OnParametersSetAsync() => RunAsync(async () =>
    {
        ClearSelection(); _message = null; _proof = null; _state = State ?? "Queue";
        var project = await Foundation.GetProjectAsync(ProjectId);
        _canQualify = project.Status == ProjectStatus.Active && Authorization.Allows(project.WorkspaceId, WorkspaceOperation.Qualify);
        var envs = (await Foundation.ListEnvironmentsAsync(ProjectId)).Where(x => x.Role == Side && x.TargetState == TargetState.Existing);
        _forests = envs.Where(x => x.Kind == EnvironmentKind.AdForest).ToList(); _tenants = envs.Where(x => x.Kind == EnvironmentKind.M365Tenant).ToList();
        _forest = _forests.FirstOrDefault()?.Id ?? Guid.Empty; _tenant = _tenants.FirstOrDefault()?.Id ?? Guid.Empty;
        await ReadBindingAsync();
    });
    private async Task ReadBindingAsync()
    {
        _binding = _forest == Guid.Empty || _tenant == Guid.Empty ? null : await Matching.GetBindingAsync(ProjectId, _forest, _tenant);
        _anchor = _binding?.Anchor?.ToString() ?? ""; _anchorReason = "";
    }
    private Task LoadBindingAsync() => RunAsync(ReadBindingAsync);
    private Task VerifyAsync() => RunAsync(async () =>
    {
        await Matching.VerifyAnchorAsync(ProjectId, _forest, _tenant, _anchor == "" ? null : Enum.Parse<SourceAnchor>(_anchor), _anchorReason);
        await ReadBindingAsync(); Updated();
    });
    private string Sheet(Guid id, EnvironmentRole side) => $"/projects/{ProjectId}/inventory?side={side}&object={id}";
    private void ChangeState(string state) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("state", state));
    private void Select(MappingRow row, bool select)
    {
        if (select) { _selected[row.Id] = new(row.Id, row.Revision); } else { _selected.Remove(row.Id); }
        _batch = null; _message = null;
    }
    private Task PreviewAsync(bool validate) => RunAsync(async () =>
    {
        _batch = null;
        var rows = _selected.Values.ToArray();
        _batch = (rows, validate, await Review.PreviewAsync(ProjectId, rows, validate));
    });
    private Task ApplyAsync() => RunAsync(async () =>
    {
        var batch = _batch!.Value; _batch = null;
        await Review.ApplyAsync(ProjectId, batch.Selection, batch.Validate, batch.Count, _reason); Updated();
    });
    private void BeginCorrection(MappingRow row) { ClearSelection(); _original = row; }
    private Task PreviewCorrectionAsync() => RunAsync(async () =>
    {
        _correction = null;
        if (!Guid.TryParse(_replacement, out var id)) { throw new ArgumentException("Invalid replacement."); }
        _replacement = id.ToString(); _correction = await Review.PreviewCorrectionAsync(ProjectId, new(_original!.Id, _original.Revision), id);
    });
    private Task CorrectAsync() => RunAsync(async () => { await Review.CorrectAsync(ProjectId, _correction!, _reason); Updated(); });
    private void ClearSelection() { _selected.Clear(); _batch = null; _original = null; _correction = null; _reason = ""; _replacement = ""; }
    private void Updated() { ClearSelection(); _revision++; _message = Text["ChangesSaved"]; }
}
