@using Clarity.Infrastructure
@inherits FoundationPage
@inject TeamsQualificationService Qualifications
@inject FoundationService Foundation
@inject WorkspaceAuthorization Authorization

<section aria-label="@Text[$"Qualification_{Kind}"]">
    <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text[$"Qualification_{Kind}"]</FluentText>
    <p>@Text["TeamsManualOnly"]</p>
    @if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
    @if (_saved) { <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false">@Text["ChangesSaved"]</FluentMessageBar> }
    @if (_state is { } state)
    {
        @if (state.NeedsReview) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Text["TeamsMetadataChanged"]</FluentMessageBar> }
        @if (state.Current is { } current)
        {
            <p>@Text[$"QualificationScope_{current.ScopeValue}"] · @current.RecordedAtUtc.ToString("u")</p>
            <p>@Text["SsoAuthor"] : @current.AuthorTenantId / @current.AuthorObjectId</p>
            <p>@current.Reason</p>
        }
        else { <p>@Text["TeamsNotQualified"]</p> }
        @if (_canQualify)
        {
            <FluentSelect TOption="QualificationScopeValue" TValue="QualificationScopeValue" Label="@Text["TeamsScopeValue"]" Items="@(Enum.GetValues<QualificationScopeValue>())"
                          OptionText="@(value => Text[$"QualificationScope_{value}"])" @bind-Value="_value" />
            <FluentTextInput Label="@Text["TeamsReason"]" @bind-Value="_reason" />
            <FluentTextInput Label="@Text["SsoEvidenceReference"]" @bind-Value="_reference" />
            <FluentSelect TOption="string" TValue="string" Label="@Text["SsoObservationEvidence"]" @bind-Value="_observation">
                <FluentOption TValue="string" Value="@string.Empty">@Text["SsoNoObservation"]</FluentOption>
                @if (state.Current?.EvidenceObservationId is { } prior && !Fields.Any(x => x.ObservationId == prior))
                { <FluentOption TValue="string" Value="@(prior.ToString())">@Text["SsoPriorEvidence"]</FluentOption> }
                @foreach (var evidence in Fields.GroupBy(x => x.ObservationId))
                { <FluentOption TValue="string" Value="@(evidence.Key.ToString())">@string.Join(", ", evidence.Select(x => x.Name))</FluentOption> }
            </FluentSelect>
            <FluentButton OnClick="SaveAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_reason))">@Text["Save"]</FluentButton>
            <FluentButton OnClick="ReloadAsync" Disabled="@Busy">@Text["SsoReload"]</FluentButton>
        }
        <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold" Block="true">@Text["SsoHistory"]</FluentText>
        <ClarityGrid @key="(ProjectId, ObjectId, Kind, _generation)" TGridItem="Assessment"
                     Load="@((p, ct) => Qualifications.HistoryAsync(ProjectId, ObjectId, Kind, p, ct))">
            <Columns>
                <PropertyColumn Property="@(a => a.Revision)" Title="@Text["SsoRevision"]" />
                <TemplateColumn Title="@Text["Date"]" Context="a">@a.RecordedAtUtc.ToString("u")</TemplateColumn>
                <TemplateColumn Title="@Text["SsoAuthor"]" Context="a">@a.AuthorTenantId / @a.AuthorObjectId</TemplateColumn>
                <TemplateColumn Title="@Text["TeamsScopeValue"]" Context="a">@Text[$"QualificationScope_{a.ScopeValue}"]<p>@a.Reason</p></TemplateColumn>
                <TemplateColumn Title="@Text["Provenance"]" Context="a">
                    <p>@(a.EvidenceReference.Length == 0 ? Text["SsoNoExternalEvidence"].Value : a.EvidenceReference)</p>
                    @if (a.EvidenceObservationId is { } evidence)
                    { <FluentButton OnClick="@(() => ShowEvidence.InvokeAsync(evidence))">@Text["Provenance"]</FluentButton> }
                </TemplateColumn>
            </Columns><EmptyContent><p>@Text["TeamsNotQualified"]</p></EmptyContent>
        </ClarityGrid>
    }
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid ObjectId { get; set; }
    [Parameter] public AssessmentKind Kind { get; set; }
    [Parameter] public IReadOnlyList<SheetField> Fields { get; set; } = [];
    [Parameter] public EventCallback<Guid> ShowEvidence { get; set; }
    private QualificationState? _state;
    private QualificationScopeValue _value;
    private string _reason = "", _reference = "", _observation = "";
    private Guid _operation = Guid.NewGuid();
    private bool _canQualify, _saved;
    private int _generation;

    protected override Task OnParametersSetAsync() => ReloadAsync();
    private Task ReloadAsync() => RunAsync(async () =>
    {
        _state = null; _saved = false;
        var project = await Foundation.GetProjectAsync(ProjectId);
        _canQualify = project.Status == ProjectStatus.Active && Authorization.Allows(project.WorkspaceId, WorkspaceOperation.Qualify);
        await LoadAsync();
    });
    private async Task LoadAsync()
    {
        _state = await Qualifications.ReadAsync(ProjectId, ObjectId, Kind);
        _value = _state.Current?.ScopeValue ?? QualificationScopeValue.Unknown;
        _reason = _state.Current?.Reason ?? "";
        _reference = _state.Current?.EvidenceReference ?? "";
        _observation = _state.Current?.EvidenceObservationId?.ToString() ?? "";
        _operation = Guid.NewGuid(); _generation++;
    }
    private Task SaveAsync() => RunAsync(async () =>
    {
        var state = _state!;
        await Qualifications.RecordAsync(ProjectId, ObjectId, Kind, new(_operation, state.Current?.Revision ?? 0, state.MetadataFingerprint,
            _value, _reason, _reference, _observation.Length == 0 ? null : Guid.Parse(_observation)));
        await LoadAsync(); _saved = true;
    });
}
