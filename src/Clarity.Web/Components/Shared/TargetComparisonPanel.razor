@using Clarity.Contracts
@using Clarity.Infrastructure
@inherits FoundationPage
@inject TargetComparisonService Targets
@inject FoundationService Foundation
@inject WorkspaceAuthorization Authorization

<section aria-label="@Text["SourceTargetComparison"]">
    <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["SourceTargetComparison"]</FluentText>
    <p>@Text["SourceTargetHint"]</p>
    @if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
    @if (_message is not null) { <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false">@_message</FluentMessageBar> }
    <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold" Block="true">@Text["TargetMappingRules"]</FluentText>
    <p>@Text["TargetMappingRulesHint"]</p>
    <FluentCheckbox @bind-Value="_includeRetired" @bind-Value:after="LoadRulesAsync" Label="@Text["ShowRetiredRules"]" />
    @if (_rules.Count == 0) { <p>@Text["NoTargetMappingRule"]</p> }
    else
    {
        <FluentDataGrid TGridItem="TargetMappingRule" Items="@(_rules.AsQueryable())" aria-label="@Text["TargetMappingRules"]">
            <TemplateColumn Title="@Text["ObjectType"]" Context="rule">@Text[$"ObjectType_{rule.ObjectType}"]</TemplateColumn>
            <TemplateColumn Title="@Text["TargetRuleKindLabel"]" Context="rule">@Text[$"TargetRuleKind_{rule.Kind}"]</TemplateColumn>
            <TemplateColumn Title="@Text["SourceField"]" Context="rule">@rule.SourceField</TemplateColumn>
            <TemplateColumn Title="@Text["TargetField"]" Context="rule">@rule.TargetField @if (rule.TargetDomain is { } domain) { <small>@($"@{domain}")</small> }</TemplateColumn>
            <TemplateColumn Title="@Text["RulePriority"]" Context="rule">@rule.Priority</TemplateColumn>
            <TemplateColumn Title="@Text["Justification"]" Context="rule">@rule.Justification</TemplateColumn>
            <TemplateColumn Title="@Text["Status"]" Context="rule">@if (rule.RetiredAtUtc is { } retired) { <span>@Text["RuleRetired"] · @retired.ToString("u") · @rule.RetirementReason</span> }
                            else { <span>@Text["RuleActive"] · @rule.CreatedAtUtc.ToString("u")</span> }</TemplateColumn>
            <TemplateColumn Title="@Text["Actions"]" Context="rule">@if (_canQualify && rule.RetiredAtUtc is null) { <FluentButton OnClick="@(() => BeginRetire(rule))">@Text["RetireRule"]</FluentButton> }</TemplateColumn>
        </FluentDataGrid>
    }
    @if (_retiring is { } retiring)
    {
        <FluentCard role="group" aria-label="@Text["RetireRule"]">
            <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold">@Text["RetireRule"] · @retiring.SourceField → @retiring.TargetField</FluentText>
            <FluentTextInput Label="@Text["Justification"]" @bind-Value="_retireReason" />
            <FluentButton OnClick="RetireAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_retireReason))">@Text["RetireRule"]</FluentButton>
            <FluentButton OnClick="@(() => _retiring = null)">@Text["Cancel"]</FluentButton>
        </FluentCard>
    }
    @if (_canQualify)
    {
        <FluentCard role="group" aria-label="@Text["AddTargetRule"]">
            <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold">@Text["AddTargetRule"]</FluentText>
            <FluentSelect TOption="string" TValue="string" Label="@Text["ObjectType"]" Items="TargetComparisonRules.ObjectTypes"
                          OptionText="@(type => Text[$"ObjectType_{type}"])" @bind-Value="_type" />
            <FluentSelect TOption="TargetRuleKind" TValue="TargetRuleKind" Label="@Text["TargetRuleKindLabel"]" Items="@(Enum.GetValues<TargetRuleKind>())"
                          OptionText="@(kind => Text[$"TargetRuleKind_{kind}"])" @bind-Value="_kind" />
            <FluentTextInput Label="@Text["SourceField"]" @bind-Value="_sourceField" />
            @if (_kind == TargetRuleKind.SharedAttribute) { <FluentTextInput Label="@Text["TargetField"]" @bind-Value="_targetField" /> }
            else { <FluentTextInput Label="@Text["TargetDomainLabel"]" @bind-Value="_domain" /> }
            <FluentNumberInput Label="@Text["RulePriority"]" Min="1" Max="100" @bind-Value="_priority" />
            <FluentTextInput Label="@Text["Justification"]" @bind-Value="_justification" />
            <FluentButton OnClick="AddRuleAsync" Disabled="@(Busy || string.IsNullOrWhiteSpace(_sourceField) || string.IsNullOrWhiteSpace(_justification))">
                @Text["AddTargetRule"]</FluentButton>
        </FluentCard>
        @if (_sources.Count == 0 || _targets.Count == 0) { <p>@Text["SourceTargetEnvironmentsMissing"]</p> }
        else
        {
            <FluentCard role="group" aria-label="@Text["CompareSourceTarget"]">
                <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold">@Text["CompareSourceTarget"]</FluentText>
                <FluentSelect TOption="ProjectEnvironment" TValue="Guid" Label="@Text["Source"]" Items="_sources"
                              OptionText="@(e => e.ExternalId)" OptionValue="@(e => e.Id)" @bind-Value="_source" />
                <FluentSelect TOption="Guid" TValue="Guid" Label="@Text["Target"]" @bind-Value="_target">
                    @foreach (var e in _targets) { <FluentOption TValue="Guid" Value="@e.Id">@e.ExternalId · @Text[e.TargetState.ToString()]</FluentOption> }
                </FluentSelect>
                <FluentButton OnClick="CompareAsync" Disabled="@Busy">@Text["CompareAction"]</FluentButton>
            </FluentCard>
        }
    }
    else { <p>@Text["ScopeReadOnly"]</p> }

    @if (_comparisons.Count == 0) { <p>@Text["NoTargetComparison"]</p> }
    else
    {
        <FluentSelect TOption="Guid?" TValue="Guid?" Label="@Text["Comparison"]" Value="@_selected?.Id" ValueChanged="Choose">
            @foreach (var c in _comparisons) { <FluentOption TValue="Guid?" Value="@c.Id">@c.Source → @c.Target · @c.ComputedAtUtc.ToString("u")</FluentOption> }
        </FluentSelect>
    }
    @if (_selected is { } comparison)
    {
        <FluentCard aria-label="@Text["TargetComparisonTotals"]">
            <p>@comparison.Source → @comparison.Target · @Text[comparison.TargetState.ToString()] · @Text[$"TargetDataState_{comparison.Data}"]
                · @comparison.ComputedAtUtc.ToString("u") · @Text["SsoAuthor"] : @comparison.ActorObjectId</p>
            @if (!string.IsNullOrWhiteSpace(comparison.Hypotheses)) { <p>@Text["TargetHypotheses"] : @comparison.Hypotheses</p> }
            @if (comparison.Data != TargetDataState.Available) { <p>@Text[$"TargetDataStateHint_{comparison.Data}"]</p> }
            <ul aria-label="@Text["TargetComparisonTotals"]">
                @foreach (var outcome in Enum.GetValues<TargetOutcome>()) { <li>@Text[$"TargetOutcome_{outcome}"] : @Count(comparison, outcome).ToString("N0")</li> }
                <li>@Text["TargetCollisions"] : @comparison.Collisions.ToString("N0")</li>
            </ul>
            <p>@Text["TargetAbsenceHint"]</p>
            <FluentDataGrid TGridItem="TargetCoverageRow" Items="@(comparison.Coverage.AsQueryable())" aria-label="@Text["Coverage"]">
                <TemplateColumn Title="@Text["Environments"]" Context="row">@Text[row.Side.ToString()]</TemplateColumn>
                <TemplateColumn Title="@Text["ObjectType"]" Context="row">@Text[$"ObjectType_{row.Type}"]</TemplateColumn>
                <TemplateColumn Title="@Text["ComparedObjects"]" Context="row">@row.Objects.ToString("N0")</TemplateColumn>
                <TemplateColumn Title="@Text["Coverage"]" Context="row">@Text[row.Exhaustive ? "TargetExhaustive" : "TargetNotExhaustiveCoverage"]</TemplateColumn>
                <TemplateColumn Title="@Text["MissingFields"]" Context="row">@(row.MissingFields.Count == 0 ? "—" : string.Join(", ", row.MissingFields))</TemplateColumn>
            </FluentDataGrid>
            <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold" Block="true">@Text["TargetOutcomes"]</FluentText>
            <FluentSelect TOption="string" TValue="string" Label="@Text["TargetOutcomeLabel"]" @bind-Value="_outcome" @bind-Value:after="Reload">
                <FluentOption TValue="string" Value="@string.Empty">@Text["All"]</FluentOption>
                @foreach (var outcome in Enum.GetValues<TargetOutcome>()) { <FluentOption TValue="string" Value="@(outcome.ToString())">@Text[$"TargetOutcome_{outcome}"]</FluentOption> }
            </FluentSelect>
            <FluentTextInput TextInputType="TextInputType.Search" Label="@Text["Search"]" @bind-Value="_search" />
            <ClarityGrid @key="(comparison.Id, _outcome, _search, _revision)" TGridItem="TargetItemRow" Search="@_search"
                         Load="@((p, ct) => Targets.ItemsAsync(ProjectId, comparison.Id, false, Outcome, null, p, ct))">
                <Columns>
                    <TemplateColumn Title="@Text["Source"]" Context="r"><FluentLink Href="@Sheet(r.SourceId, EnvironmentRole.Source)">@(r.Label ?? r.SourceId.ToString())</FluentLink>
                        <small>@Text[$"ObjectType_{r.ObjectType}"]</small></TemplateColumn>
                    <TemplateColumn Title="@Text["TargetOutcomeLabel"]" Context="r">@Text[$"TargetOutcome_{r.Outcome}"]
                        <small>@Text[$"TargetReason_{r.Reason}"]</small></TemplateColumn>
                    <TemplateColumn Title="@Text["TargetKey"]" Context="r">@r.Key <small>@RuleLabel(comparison, r.RuleId)</small></TemplateColumn>
                    <TemplateColumn Title="@Text["Target"]" Context="r">
                        @if (r.TargetId is { } target) { <FluentLink Href="@Sheet(target, EnvironmentRole.Target)">@(r.TargetLabel ?? target.ToString())</FluentLink> }
                        else if (r.CandidateCount > 1) { <span>@r.CandidateCount @Text["Candidates"]</span> }
                        else { <span>—</span> }
                        @if (r.OtherId is { } other) { <small>@Text["SharedWith"] <FluentLink Href="@Sheet(other, EnvironmentRole.Source)">@(r.OtherLabel ?? other.ToString())</FluentLink></small> }
                    </TemplateColumn>
                </Columns>
                <EmptyContent><p>@Text["NoTargetItems"]</p></EmptyContent>
            </ClarityGrid>
            <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold" Block="true">@Text["TargetCollisions"]</FluentText>
            <p>@Text["TargetCollisionsHint"]</p>
            <FluentSelect TOption="string" TValue="string" Label="@Text["CollisionKindLabel"]" @bind-Value="_collision" @bind-Value:after="Reload">
                <FluentOption TValue="string" Value="@string.Empty">@Text["All"]</FluentOption>
                @foreach (var kind in Enum.GetValues<CollisionKind>()) { <FluentOption TValue="string" Value="@(kind.ToString())">@Text[$"CollisionKind_{kind}"]</FluentOption> }
            </FluentSelect>
            <ClarityGrid @key="(comparison.Id, _collision, _revision)" TGridItem="TargetItemRow"
                         Load="@((p, ct) => Targets.ItemsAsync(ProjectId, comparison.Id, true, null, Collision, p, ct))">
                <Columns>
                    <TemplateColumn Title="@Text["CollisionKindLabel"]" Context="r">@Text[$"CollisionKind_{r.Collision}"]
                        <small>@Text[$"TargetReason_{r.Reason}"]</small></TemplateColumn>
                    <TemplateColumn Title="@Text["TargetKey"]" Context="r">@r.Key <small>@RuleLabel(comparison, r.RuleId)</small></TemplateColumn>
                    <TemplateColumn Title="@Text["Source"]" Context="r">
                        @if (r.SourceId is { } source) { <FluentLink Href="@Sheet(source, EnvironmentRole.Source)">@(r.Label ?? source.ToString())</FluentLink> } else { <span>—</span> }
                        @if (r.OtherId is { } other) { <small>@Text["SharedWith"] <FluentLink Href="@Sheet(other, EnvironmentRole.Source)">@(r.OtherLabel ?? other.ToString())</FluentLink></small> }
                    </TemplateColumn>
                    <TemplateColumn Title="@Text["Target"]" Context="r">
                        @if (r.TargetId is { } target) { <FluentLink Href="@Sheet(target, EnvironmentRole.Target)">@(r.TargetLabel ?? target.ToString())</FluentLink> } else { <span>—</span> }
                    </TemplateColumn>
                </Columns>
                <EmptyContent><p>@Text["NoTargetCollisions"]</p></EmptyContent>
            </ClarityGrid>
        </FluentCard>
    }
    <MappingPanel @key="(ProjectId, _revision)" ProjectId="ProjectId" Side="EnvironmentRole.Source" Kind="MappingKind.SourceTarget" />
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private IReadOnlyList<TargetMappingRule> _rules = [];
    private IReadOnlyList<ProjectEnvironment> _sources = [], _targets = [];
    private IReadOnlyList<TargetComparisonSummary> _comparisons = [];
    private TargetComparisonSummary? _selected;
    private TargetMappingRule? _retiring;
    private Guid _source, _target, _compareOperation = Guid.NewGuid(), _ruleOperation = Guid.NewGuid();
    private TargetRuleKind _kind = TargetRuleKind.SharedAttribute;
    private string _type = "user", _sourceField = "", _targetField = "", _domain = "", _justification = "", _retireReason = "";
    private string _outcome = "", _collision = "", _search = "";
    private string? _message;
    private int _priority = 1, _revision;
    private bool _canQualify, _includeRetired;

    private TargetOutcome? Outcome => Enum.TryParse<TargetOutcome>(_outcome, out var value) ? value : null;
    private CollisionKind? Collision => Enum.TryParse<CollisionKind>(_collision, out var value) ? value : null;

    protected override Task OnParametersSetAsync() => RunAsync(async () =>
    {
        var project = await Foundation.GetProjectAsync(ProjectId);
        _canQualify = project.Status == ProjectStatus.Active && Authorization.Allows(project.WorkspaceId, WorkspaceOperation.Qualify);
        var environments = await Foundation.ListEnvironmentsAsync(ProjectId);
        _sources = environments.Where(e => e.Role == EnvironmentRole.Source && e.TargetState == TargetState.Existing).ToList();
        _targets = environments.Where(e => e.Role == EnvironmentRole.Target).ToList();
        _source = _sources.FirstOrDefault()?.Id ?? Guid.Empty;
        _target = _targets.FirstOrDefault()?.Id ?? Guid.Empty;
        _rules = await Targets.RulesAsync(ProjectId, _includeRetired);
        _comparisons = await Targets.ComparisonsAsync(ProjectId);
        _selected = _comparisons.FirstOrDefault();
    });

    private string Sheet(Guid? id, EnvironmentRole side) => $"/projects/{ProjectId}/inventory?side={side}&object={id}";
    private string RuleLabel(TargetComparisonSummary comparison, Guid? id) =>
        comparison.Rules.FirstOrDefault(r => r.Id == id) is { } rule
            ? rule.Kind == TargetRuleKind.ComputedUpn ? $"{rule.SourceField} → {rule.TargetField} @{rule.TargetDomain}" : $"{rule.SourceField} → {rule.TargetField}"
            : "";
    private static int Count(TargetComparisonSummary c, TargetOutcome outcome) => outcome switch
    {
        TargetOutcome.Matched => c.Matched,
        TargetOutcome.Ambiguous => c.Ambiguous,
        TargetOutcome.Absent => c.Absent,
        TargetOutcome.Unknown => c.Unknown,
        _ => c.NotCompared
    };
    private void Reload() => _revision++;
    private void Choose(Guid? id)
    {
        _selected = _comparisons.FirstOrDefault(c => c.Id == id) ?? _selected;
        _revision++;
    }
    private void BeginRetire(TargetMappingRule rule) { _retiring = rule; _retireReason = ""; _message = null; }

    private Task LoadRulesAsync() => RunAsync(async () => _rules = await Targets.RulesAsync(ProjectId, _includeRetired));

    private Task AddRuleAsync() => RunAsync(async () =>
    {
        await Targets.AddRuleAsync(ProjectId, new(_type, _kind, _sourceField, _targetField,
            string.IsNullOrWhiteSpace(_domain) ? null : _domain, _priority, _justification), _ruleOperation);
        _ruleOperation = Guid.NewGuid();
        _sourceField = ""; _targetField = ""; _domain = ""; _justification = "";
        _rules = await Targets.RulesAsync(ProjectId, _includeRetired);
        _message = Messages["TargetRuleAdded"];
    });

    private Task RetireAsync() => RunAsync(async () =>
    {
        await Targets.RetireRuleAsync(ProjectId, _retiring!.Id, _retireReason);
        _retiring = null; _retireReason = "";
        _rules = await Targets.RulesAsync(ProjectId, _includeRetired);
        _message = Messages["TargetRuleRetired"];
    });

    private Task CompareAsync() => RunAsync(async () =>
    {
        var id = await Targets.CompareAsync(ProjectId, _source, _target, _compareOperation);
        _compareOperation = Guid.NewGuid();
        _comparisons = await Targets.ComparisonsAsync(ProjectId);
        _selected = _comparisons.FirstOrDefault(c => c.Id == id);
        _revision++;
        _message = Messages["TargetCompared"];
    });
}
