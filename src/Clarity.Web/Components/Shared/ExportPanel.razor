@using Clarity.Infrastructure
@inherits FoundationPage
@inject ExportService Exports
@inject InventoryQueries Queries
@inject ScopeService Scope
@inject FoundationService Foundation
@inject WorkspaceAuthorization Authorization
@inject DiscoveryAvailability Availability

<FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold" Block="true">@Text["Exports"] · @Text[Side.ToString()]</FluentText>
<p>@Text["ExportHint"]</p>
@if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
@if (_message is not null) { <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false">@_message</FluentMessageBar> }
@if (!Availability.Storage) { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["StorageRequired"]</FluentMessageBar> }
else if (!_canExport) { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["ExportReadOnlyHint"]</FluentMessageBar> }
else
{
    <section aria-label="@Text["NewExport"]">
        <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["NewExport"]</FluentText>
        <FluentSelect TOption="string" TValue="string" Label="@Text["Environments"]" @bind-Value="_environment">
            <FluentOption TValue="string" Value="@string.Empty">@Text["All"]</FluentOption>
            @foreach (var e in _environments) { <FluentOption TValue="string" Value="@(e.Id.ToString())">@e.ExternalId</FluentOption> }
        </FluentSelect>
        <FluentSelect TOption="string" TValue="string" Label="@Text["ObjectType"]" @bind-Value="_type">
            <FluentOption TValue="string" Value="@string.Empty">@Text["All"]</FluentOption>
            @foreach (var t in _types) { <FluentOption TValue="string" Value="@t">@TypeName(t)</FluentOption> }
        </FluentSelect>
        <FluentSelect TOption="string" TValue="string" Label="@Text["Status"]" @bind-Value="_status">
            <FluentOption TValue="string" Value="@string.Empty">@Text["All"]</FluentOption>
            @foreach (var s in Statuses) { <FluentOption TValue="string" Value="@s">@Text[s]</FluentOption> }
        </FluentSelect>
        <FluentSelect TOption="ExportDecisionFilter" TValue="ExportDecisionFilter" Label="@Text["ScopeDecisionValue"]" Items="@(Enum.GetValues<ExportDecisionFilter>())"
                      OptionText="@(d => DecisionName(d))" @bind-Value="_decision" />
        <FluentTextInput Label="@Text["ExportWave"]" @bind-Value="_wave" />
        <FluentSelect TOption="string" TValue="string" Label="@Text["ExportPopulation"]" @bind-Value="_population">
            <FluentOption TValue="string" Value="@string.Empty">@Text["All"]</FluentOption>
            @foreach (var p in _populations) { <FluentOption TValue="string" Value="@(p.Id.ToString())">@p.Name · @p.Environment</FluentOption> }
        </FluentSelect>
        <p>@Text["ExportSelectionHint"]</p>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="LaunchAsync" Disabled="@Busy">@Text["LaunchExport"]</FluentButton>
    </section>
}
<FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)"><FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["ExportHistory"]</FluentText>
    <FluentButton OnClick="@(() => _revision++)">@Text["ExportRefresh"]</FluentButton></FluentStack>
<ClarityGrid @key="(ProjectId, Side, _revision)" TGridItem="ExportRow" Load="@((p, ct) => Exports.PageAsync(ProjectId, Side, p, ct))">
    <Columns>
        <TemplateColumn Title="@Text["ExportAsOf"]" Context="r">@r.AsOfUtc.ToString("u")
            <small>@Text["SsoAuthor"] : @r.AuthorTenantId / @r.AuthorObjectId</small></TemplateColumn>
        <TemplateColumn Title="@Text["ExportFilters"]" Context="r">@Filters(r)</TemplateColumn>
        <TemplateColumn Title="@Text["Status"]" Context="r">@Text[r.State.ToString()]
            @if (r.ErrorCode is { } failure) { <p>@ErrorText(failure) <code>@failure</code></p> }
            @if (r.GeneratedAtUtc is { } generated) { <small>@Text["ExportGeneratedAt"] @generated.ToString("u")</small> }</TemplateColumn>
        <TemplateColumn Title="@Text["ExportCounters"]" Context="r">
            @if (r.ObjectCount is { } objects)
            {
                <span>@Text["ExportObjects"] : @objects.ToString("N0") · @Text["ExportExceptions"] : @(r.ExceptionCount?.ToString("N0"))
                    · @Text["ExportMappings"] : @(r.MappingCount?.ToString("N0"))</span>
                @if (r.CoverageGaps is > 0) { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["ExportCoverageGaps"] : @r.CoverageGaps</FluentMessageBar> }
            }
            <small>@Text["ExportSelectionHash"] <code>@r.SelectionHash[..12]</code></small></TemplateColumn>
        <TemplateColumn Title="@Text["ExportFiles"]" Context="r">
            @if (r.FilesPurgedAtUtc is { } purged) { <FluentText>@Text["ExportFilesExpired"] @purged.ToString("u")</FluentText> }
            else if (r.Artifacts.Count == 0) { <span>@Text["ExportNoFiles"]</span> }
            <ul aria-label="@Text["ExportFiles"]">
                @foreach (var a in r.Artifacts)
                {
                    <li>@if (r.FilesPurgedAtUtc is null) { <FluentLink Href="@($"/api/projects/{ProjectId}/exports/{r.Id}/artifacts/{a.Id}")" download ForceLoad="true">@Text[$"ExportArtifact_{a.Kind}"]</FluentLink> }
                        else { <FluentText>@Text[$"ExportArtifact_{a.Kind}"]</FluentText> }
                        <small>@a.FileName · @a.RowCount.ToString("N0") @Text["ExportRows"] · @Size(a.Bytes) · SHA-256 @a.ContentHash[..12]</small></li>
                }
            </ul></TemplateColumn>
    </Columns>
    <EmptyContent><p>@Text["NoExports"]</p></EmptyContent>
</ClarityGrid>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EnvironmentRole Side { get; set; }
    private static readonly string[] Statuses = ["Observed", "AbsentFromScope", "Deleted", "Unknown", "Enabled", "Disabled"];
    private IReadOnlyList<ProjectEnvironment> _environments = [];
    private IReadOnlyList<string> _types = [];
    private IReadOnlyList<PopulationRow> _populations = [];
    private string _environment = "", _type = "", _status = "", _wave = "", _population = "";
    private ExportDecisionFilter _decision = ExportDecisionFilter.All;
    private string? _message;
    private bool _canExport;
    private int _revision;
    private Guid _operation = Guid.NewGuid();

    protected override Task OnParametersSetAsync() => RunAsync(async () =>
    {
        _message = null;
        var project = await Foundation.GetProjectAsync(ProjectId);
        _canExport = project.Status == ProjectStatus.Active && Authorization.Allows(project.WorkspaceId, WorkspaceOperation.Export);
        _environments = (await Foundation.ListEnvironmentsAsync(ProjectId)).Where(e => e.Role == Side && e.TargetState == TargetState.Existing).ToList();
        if (_canExport && Availability.Storage)
        {
            _types = (await Queries.OptionsAsync(ProjectId, Side)).Types;
            _populations = (await Scope.PopulationsAsync(ProjectId, Side, new PageRequest(0, 100))).Items;
        }
    });

    private string TypeName(string type) => Text[$"ObjectType_{type}"] is { ResourceNotFound: false } label ? label.Value : type;

    private string DecisionName(ExportDecisionFilter decision) => decision switch
    {
        ExportDecisionFilter.All => Text["All"],
        ExportDecisionFilter.Undecided => Text["Export_Undecided"],
        _ => Text[$"ScopeDecision_{decision}"]
    };

    private string ErrorText(string code) => Text[$"ExportError_{code}"] is { ResourceNotFound: false } text ? text.Value : Text["ExportErrorGeneric"];

    private string Filters(ExportRow row) => string.Join(" · ", new[]
    {
        row.Environment ?? Text["All"].Value,
        row.Filter.Type is { } type ? TypeName(type) : null,
        row.Filter.Status is { } status ? Text[status].Value : null,
        row.Filter.Decision == ExportDecisionFilter.All ? null : DecisionName(row.Filter.Decision),
        row.Filter.Wave is { } wave ? $"{Text["ExportWave"]} {wave}" : null,
        row.Population is { } population ? $"{Text["ExportPopulation"]} {population}" : null
    }.Where(x => x is not null));

    private static string Size(long bytes) => bytes < 1024 * 1024
        ? $"{Math.Max(1, bytes / 1024.0):N0} Ko"
        : $"{bytes / (1024.0 * 1024):N1} Mo";

    private Task LaunchAsync() => RunAsync(async () =>
    {
        var filter = new ExportFilter(Side, Guid.TryParse(_environment, out var environment) ? environment : null, _type, _status, _decision, _wave,
            Guid.TryParse(_population, out var population) ? population : null);
        await Exports.LaunchAsync(ProjectId, new ExportRequest(_operation, filter));
        _operation = Guid.NewGuid();
        _revision++;
        _message = Messages["ExportQueued"];
    });
}
