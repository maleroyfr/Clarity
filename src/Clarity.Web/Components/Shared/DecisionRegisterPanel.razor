@using Clarity.Infrastructure
@inherits FoundationPage
@inject DecisionRegisterService Register
@inject ScopeService Scope

<FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["DecisionRegister"]</FluentText>
<p>@Text["DecisionRegisterHint"]</p>
@if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
@if (_message is not null) { <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false">@_message</FluentMessageBar> }
<ul aria-label="@Text["DecisionRegisterSummary"]">
    @foreach (var count in _summary)
    { <li>@Text[$"DecisionKind_{count.Kind}"] : @count.Total.ToString("N0") · @Text["ToReview"] : @count.ToReview.ToString("N0")</li> }
</ul>
@if (CanQualify)
{ <FluentButton OnClick="RecomputeAsync" Disabled="@Busy">@Text["RecomputeReview"]</FluentButton> }
<FluentSelect TOption="DecisionKind" TValue="DecisionKind" Label="@Text["DecisionKind"]" Items="@(Enum.GetValues<DecisionKind>())"
              OptionText="@(kind => Text[$"DecisionKind_{kind}"])" Value="@_kind" ValueChanged="ChangeKind" />
<FluentCheckbox @bind-Value="_toReviewOnly" @bind-Value:after="@(() => _revision++)" Label="@Text["ToReviewOnly"]" />
<FluentTextInput TextInputType="TextInputType.Search" Label="@Text["Search"]" @bind-Value="_search" />
<ClarityGrid @key="(ProjectId, Side, _kind, _toReviewOnly, _search, _revision)" TGridItem="DecisionRegisterRow" Search="@_search"
             Load="@((p, ct) => Register.PageAsync(ProjectId, Side, _kind, _toReviewOnly, p, ct))">
    <Columns>
        <TemplateColumn Title="@Text["Name"]" Context="r"><FluentLink Href="@Sheet(r.ObjectId)">@r.Label</FluentLink>
            <small>@Text[$"ObjectType_{r.Type}"] · @Text[r.Presence.ToString()]</small></TemplateColumn>
        <TemplateColumn Title="@Text["DecisionKind"]" Context="r">@Text[r.ValueKey]
            @if (r.Kind == DecisionKind.Scope) { <span> · @(r.Wave ?? Text["NoWave"].Value)</span> }
            else if (r.Detail is { } detail) { <span> → @detail</span> }
            <small>@Text["SsoRevision"] @r.Revision</small></TemplateColumn>
        <TemplateColumn Title="@Text["Justification"]" Context="r">@r.Reason
            <small>@(r.DecidedAtUtc?.ToString("u")) · @r.AuthorObjectId</small></TemplateColumn>
        <TemplateColumn Title="@Text["Status"]" Context="r">
            @if (!r.NeedsReview) { <span>@Text["DecisionUpToDate"]</span> }
            else
            {
                <strong>@Text["ToReview"]</strong>
                @if (r.FlaggedAtUtc is { } flagged) { <small>@Text["FlaggedSince"] @flagged.ToString("u")</small> }
                @if (r.Kind == DecisionKind.Mapping) { <p>@Text["MappingChangesHint"]</p> }
                else if (r.Changes is { } changes)
                {
                    <ul aria-label="@Text["ChangedFields"]">
                        @foreach (var change in changes)
                        { <li>@change.Field : @Value(change, change.Before) → @Value(change, change.After)</li> }
                    </ul>
                }
                else { <p>@Text["DecisionChangesUnknown"]</p> }
            }
        </TemplateColumn>
        <TemplateColumn Title="@Text["Actions"]" Context="r">
            @if (r.Kind == DecisionKind.Scope)
            {
                <FluentButton OnClick="@(() => _history = r)">@Text["ScopeHistory"]</FluentButton>
                @if (CanQualify && r.NeedsReview) { <FluentButton OnClick="@(() => OpenReconfirm(r))" Disabled="@Busy">@Text["Reconfirm"]</FluentButton> }
            }
            else if (r.Kind == DecisionKind.Mapping) { <FluentLink Href="@($"/projects/{ProjectId}/inventory?side={Side}&view=Mappings")">@Text["MappingReview"]</FluentLink> }
            else { <FluentLink Href="@Sheet(r.ObjectId)">@Text[CanQualify ? "QualifyFromSheet" : "ObjectSheet"]</FluentLink> }
        </TemplateColumn>
    </Columns>
    <EmptyContent><p>@Text["NoDecisions"]</p></EmptyContent>
</ClarityGrid>
@if (_reconfirm is { } target)
{
    <DetailPanel Title="@($"{Text["Reconfirm"]} · {target.Label}")" Error="@Error" Close="@(() => _reconfirm = null)">
        <p>@Text["ReconfirmHint"]</p>
        <p>@Text[target.ValueKey] · @(target.Wave ?? Text["NoWave"].Value)</p>
        <FluentTextInput Label="@Text["Justification"]" @bind-Value="_reason" />
        <FluentButton OnClick="PreviewAsync" Disabled="@Busy">@Text["PreviewSelectionDecision"]</FluentButton>
        @if (_preview is { } preview)
        {
            <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["AffectedObjects"] : @preview.Result.Affected · @Text["ReconfirmedObjects"] : @preview.Result.Reconfirmed</FluentMessageBar>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ReconfirmAsync"
                          Disabled="@(Busy || preview.Result.Affected == 0 || string.IsNullOrWhiteSpace(_reason))">@Text["ConfirmDecisions"]</FluentButton>
        }
    </DetailPanel>
}
@if (_history is { } history)
{
    <DetailPanel Title="@($"{Text["ScopeHistory"]} · {history.Label}")" Close="@(() => _history = null)">
        <ClarityGrid @key="history.ObjectId" TGridItem="ScopeHistoryRow" Load="@((p, ct) => Scope.HistoryAsync(ProjectId, history.ObjectId, p, ct))">
            <Columns>
                <PropertyColumn Property="@(h => h.Number)" Title="@Text["SsoRevision"]" />
                <TemplateColumn Title="@Text["Date"]" Context="h">@h.OccurredAtUtc.ToString("u")</TemplateColumn>
                <TemplateColumn Title="@Text["SsoAuthor"]" Context="h">@h.ActorObjectId</TemplateColumn>
                <TemplateColumn Title="@Text["ScopeDecisionValue"]" Context="h">@Text[$"ScopeDecision_{h.Value}"] · @(h.Wave ?? Text["NoWave"].Value)
                    <small>@h.Population</small><p>@h.Reason</p></TemplateColumn>
            </Columns>
            <EmptyContent><p>@Text["NoScopeDecisions"]</p></EmptyContent>
        </ClarityGrid>
    </DetailPanel>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EnvironmentRole Side { get; set; }
    [Parameter] public bool CanQualify { get; set; }
    private IReadOnlyList<DecisionKindCount> _summary = [];
    private DecisionKind _kind = DecisionKind.Scope;
    private bool _toReviewOnly = true;
    private string _search = "", _reason = "";
    private string? _message;
    private int _revision;
    private DecisionRegisterRow? _reconfirm, _history;
    private (ScopeBatch Batch, ScopePreview Result)? _preview;
    private Guid _operation = Guid.NewGuid();

    protected override Task OnParametersSetAsync() => RunAsync(LoadAsync);

    private async Task LoadAsync() => _summary = await Register.SummaryAsync(ProjectId, Side);

    private string Sheet(Guid id) => $"/projects/{ProjectId}/inventory?side={Side}&object={id}";

    private string? Value(BasisChange change, string? value) => value is null ? "∅"
        : change.Field == DecisionBasis.PresenceField ? Text[value].Value : value;

    private void ChangeKind(DecisionKind kind)
    {
        _kind = kind; _revision++;
    }


    private void OpenReconfirm(DecisionRegisterRow row) { _reconfirm = row; _preview = null; _reason = ""; _operation = Guid.NewGuid(); }

    private Task RecomputeAsync() => RunAsync(async () =>
    {
        var flagged = await Register.RecomputeAsync(ProjectId);
        await LoadAsync();
        _revision++;
        _message = string.Format(System.Globalization.CultureInfo.CurrentCulture, Text["ReviewRecomputed"].Value, flagged);
    });

    private Task PreviewAsync() => RunAsync(async () =>
    {
        var target = _reconfirm!;
        var batch = new ScopeBatch(_operation, target.ScopeValue!.Value, target.Wave, _reason, ObjectIds: [target.ObjectId]);
        _preview = (batch, await Scope.PreviewAsync(ProjectId, batch));
    });

    private Task ReconfirmAsync() => RunAsync(async () =>
    {
        var (batch, result) = _preview!.Value;
        await Scope.ApplyAsync(ProjectId, batch with { Reason = _reason }, result.Affected);
        _reconfirm = null; _preview = null; _reason = "";
        await LoadAsync();
        _revision++;
        _message = Messages["ChangesSaved"];
    });
}
