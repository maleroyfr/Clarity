@using Clarity.Infrastructure
@inherits FoundationPage
@inject ScenarioOverviewService Scenarios

<section class="scenario-panel" aria-labelledby="scenario-heading">
    @if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
    @if (_data is { } data)
    {
        var keySteps = data.Steps.Where(s => s.Key).ToList();
        <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold" Id="scenario-heading" Block="true">@Text["ScenarioWorkflow"] · @Text[data.Scenario.ToString()]</FluentText>
        <p>@Text[$"ScenarioGuide_{data.Scenario}"]</p>
        var completed = keySteps.Count(s => s.State == ScenarioStepState.Done);
        <p id="scenario-progress">@Text["ScenarioProgress", completed, keySteps.Count]</p>
        @if (keySteps.Count > 0)
        {
            <FluentProgressBar Min="0" Max="@keySteps.Count" Value="@completed" aria-labelledby="scenario-progress" />
        }
        @if (data.Next is { } next)
        {
            <p class="scenario-next"><strong>@Text["ScenarioNextStep"] :</strong> <FluentLink Href="@StepLink(next)">@Text[$"Step_{next.Step}"]</FluentLink> · @Text[next.HintKey]</p>
        }
        else { <p class="scenario-next">@Text["ScenarioNoNextStep"]</p> }
        <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["ScenarioSteps"]</FluentText>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalM)" role="list" aria-label="@Text["ScenarioSteps"]">
            @foreach (var step in data.Steps)
            {
                <FluentCard role="listitem">
                    <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)">
                        <FluentLink Href="@StepLink(step)">@Text[$"Step_{step.Step}"]</FluentLink>
                        <FluentBadge Content="@Text[$"StepState_{step.State}"]" />
                        <FluentText Size="TextSize.Size200">@Text[step.Key ? "StepKey" : "StepSupporting"]</FluentText>
                    </FluentStack>
                    <p>@Text[step.HintKey]</p>
                    @if (step.State != ScenarioStepState.Waiting && step.Counts.Count > 0)
                    {
                        <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalM)" role="list" aria-label="@Text["StepCounts"]">
                            @foreach (var count in step.Counts)
                            { <FluentText role="listitem">@Text[$"StepCount_{count.Label}"] : @count.Value.ToString("N0")</FluentText> }
                        </FluentStack>
                    }
                </FluentCard>
            }
        </FluentStack>
        <p><small>@Text["ScenarioReadOnlyHint"]</small></p>
    }
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public int Revision { get; set; }
    private ScenarioOverview? _data;

    private string StepLink(ScenarioStepView step)
    {
        var root = $"/projects/{ProjectId}";
        var side = $"side={step.Side}";
        return step.Step switch
        {
            ScenarioStep.Source or ScenarioStep.Target => $"{root}/overview?{side}",
            ScenarioStep.SourceCollection or ScenarioStep.TargetCollection => $"{root}/discovery?{side}",
            ScenarioStep.Populations => $"{root}/scope?{side}",
            ScenarioStep.ScopeDecisions => $"{root}/scope?{side}&view=decisions",
            ScenarioStep.Dependencies => $"{root}/scope?{side}&view=dependencies",
            ScenarioStep.DecisionReview => $"{root}/scope?{side}&view=review",
            ScenarioStep.RunComparison => $"{root}/comparison?{side}",
            ScenarioStep.MappingRules or ScenarioStep.SourceTargetComparison => $"{root}/comparison?{side}&view=target",
            _ => $"{root}/exports?{side}"
        };
    }

    protected override Task OnParametersSetAsync() => RunAsync(async () => { _data = null; _data = await Scenarios.ReadAsync(ProjectId); });
}
