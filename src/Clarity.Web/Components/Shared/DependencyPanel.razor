@using Clarity.Infrastructure
@inherits FoundationPage
@inject DependencyService Dependencies

<FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["Dependencies"]</FluentText>
<p>@Text["DependenciesHint"]</p>
@if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
@if (_message is not null) { <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false">@_message</FluentMessageBar> }
@if (CanQualify && Environments.Count != 0)
{
    <FluentCard role="group" aria-label="@Text["AnalyzeDependencies"]">
        <FluentText As="TextTag.H4" Size="TextSize.Size400" Weight="TextWeight.Semibold">@Text["AnalyzeDependencies"]</FluentText>
        <FluentSelect TOption="ProjectEnvironment" TValue="Guid" Label="@Text["Environments"]" Items="Environments"
                      OptionText="@(e => e.ExternalId)" OptionValue="@(e => e.Id)" @bind-Value="_environment" />
        <FluentTextInput Label="@Text["MigrationWave"]" @bind-Value="_wave" />
        <p>@Text["DependencyWaveHint"]</p>
        <FluentButton OnClick="AnalyzeAsync" Disabled="@Busy">@Text["AnalyzeDependencies"]</FluentButton>
    </FluentCard>
}
else if (!CanQualify) { <p>@Text["ScopeReadOnly"]</p> }
@if (_analyses.Count == 0) { <p>@Text["NoDependencyAnalysis"]</p> }
else
{
    <FluentSelect TOption="Guid?" TValue="Guid?" Label="@Text["DependencyAnalysis"]" Value="@_selected?.Id" ValueChanged="Choose">
        @foreach (var a in _analyses)
        { <FluentOption TValue="Guid?" Value="@a.Id">@a.Environment · @(a.Wave ?? Text["AllWaves"].Value) · @a.ComputedAtUtc.ToString("u")</FluentOption> }
    </FluentSelect>
}
@if (_selected is { } analysis)
{
    <FluentCard aria-label="@Text["DependencyAnalysis"]">
        <p>@analysis.Environment · @(analysis.Wave ?? Text["AllWaves"].Value) · @analysis.ComputedAtUtc.ToString("u") · @Text["SsoAuthor"] : @analysis.ActorObjectId</p>
        <ul aria-label="@Text["DependencyPrincipals"]">
            @foreach (var side in Enum.GetValues<DependencySide>())
            { <li>@Text[$"DependencySide_{side}"] : @Principals(analysis, side).ToString("N0")</li> }
        </ul>
        <ul aria-label="@Text["DependencyTotals"]">
            <li>@Text["DependencyResources"] : @analysis.Resources.ToString("N0") · @Text["DependencyClassification_Shared"] : @analysis.SharedResources.ToString("N0")</li>
            <li>@Text["KnownVolume"] : @Size(analysis.KnownVolumeBytes) · @Text["SharedVolume"] : @Size(analysis.SharedVolumeBytes)
                · @Text["UnknownVolumeResources"] : @analysis.UnknownVolumeResources.ToString("N0")</li>
            <li>@Text["UnresolvedLinks"] : @analysis.UnresolvedLinks.ToString("N0")</li>
        </ul>
        <p>@Text["DependencyVolumeHint"]</p>
        <FluentDataGrid TGridItem="DependencyFamilyCoverage" Items="@(analysis.Coverage.AsQueryable())" aria-label="@Text["AnalysisCoverage"]">
            <TemplateColumn Title="@Text["DependencyFamily"]" Context="coverage">@Text[$"DependencyFamily_{coverage.Family}"]</TemplateColumn>
            <TemplateColumn Title="@Text["DependencyResources"]" Context="coverage">@{ var count = analysis.Families.FirstOrDefault(f => f.Family == coverage.Family); }
                @(count?.Resources ?? 0) · @Text["DependencyClassification_Shared"] : @(count?.Shared ?? 0)</TemplateColumn>
            <TemplateColumn Title="@Text["AnalysisCoverage"]" Context="coverage">@Text[$"DependencyCoverage_{coverage.Status}"]
                            @if (coverage.UnresolvedLinks != 0) { <small>@Text["UnresolvedLinks"] : @coverage.UnresolvedLinks</small> }
                            @if (coverage.MembersNotCollected != 0) { <small>@Text["MembersNotCollected"] : @coverage.MembersNotCollected</small> }</TemplateColumn>
            <TemplateColumn Title="@Text["Sections"]" Context="coverage">@foreach (var section in coverage.Sections)
                            {
                                <small>@section.CapabilityId : @(section.Coverage is { } c ? Text[c.ToString()].Value : Text["NotCollected"].Value)
                                    @if (section.ResourceScoped && section.Coverage is not null) { <span> · @Text["ResourceScoped"]</span> }</small>
                            }
                            @if (coverage.Sections.Count == 0) { <small>@Text["NotApplicable"]</small> }</TemplateColumn>
        </FluentDataGrid>
        <FluentSelect TOption="string" TValue="string" Label="@Text["DependencyFamily"]" @bind-Value="_family" @bind-Value:after="Reload">
            <FluentOption TValue="string" Value="@string.Empty">@Text["All"]</FluentOption>
            @foreach (var family in Enum.GetValues<DependencyFamily>()) { <FluentOption TValue="string" Value="@(family.ToString())">@Text[$"DependencyFamily_{family}"]</FluentOption> }
        </FluentSelect>
        <FluentSelect TOption="string" TValue="string" Label="@Text["DependencyClassification"]" @bind-Value="_classification" @bind-Value:after="Reload">
            <FluentOption TValue="string" Value="@string.Empty">@Text["All"]</FluentOption>
            @foreach (var value in Enum.GetValues<DependencyClassification>()) { <FluentOption TValue="string" Value="@(value.ToString())">@Text[$"DependencyClassification_{value}"]</FluentOption> }
        </FluentSelect>
        <FluentTextInput TextInputType="TextInputType.Search" Label="@Text["Search"]" @bind-Value="_search" />
        <ClarityGrid @key="(analysis.Id, _family, _classification, _search, _revision)" TGridItem="DependencyResourceRow" Search="@_search"
                     Load="@((p, ct) => Dependencies.ResourcesAsync(ProjectId, analysis.Id, Filter, p, ct))">
            <Columns>
                <TemplateColumn Title="@Text["Name"]" Context="r"><FluentLink Href="@Sheet(r.ObjectId)">@(r.DisplayName ?? r.ObjectId.ToString())</FluentLink>
                    <small>@Text[$"DependencyFamily_{r.Family}"] · @Text[$"ObjectType_{r.Type}"]</small></TemplateColumn>
                <TemplateColumn Title="@Text["DependencyClassification"]" Context="r">@Text[$"DependencyClassification_{r.Classification}"]
                    @if (r.AllUsers) { <small>@Text["AllUsersAssignment"]</small> }
                    @if (r.MembersNotCollected) { <small>@Text["MembersNotCollected"]</small> }
                    @if (r.UnresolvedLinks != 0) { <small>@Text["UnresolvedLinks"] : @r.UnresolvedLinks</small> }</TemplateColumn>
                <TemplateColumn Title="@Text["DependencyPrincipals"]" Context="r">
                    <small>@Text["DependencySide_Migrating"] : @r.Migrating</small>
                    @if (r.OtherWave != 0) { <small>@Text["DependencySide_OtherWave"] : @r.OtherWave</small> }
                    @if (r.Arbitrate != 0) { <small>@Text["DependencySide_ToArbitrate"] : @r.Arbitrate</small> }
                    @if (r.Remaining != 0) { <small>@Text["DependencySide_Remaining"] : @r.Remaining</small> }</TemplateColumn>
                <TemplateColumn Title="@Text["Volume"]" Context="r">@(r.VolumeApplies ? r.VolumeBytes is { } bytes ? Size(bytes) : Text["UnknownVolume"].Value : "—")</TemplateColumn>
                <TemplateColumn Title="@Text["ScopeDecisionValue"]" Context="r">
                    @if (r.Decision is { } value) { <span>@Text[$"ScopeDecision_{value}"] · @(r.DecisionWave ?? Text["NoWave"].Value)</span> }
                    else { <span>@Text["NoScopeDecision"]</span> }</TemplateColumn>
                <TemplateColumn Title="@Text["Actions"]" Context="r">
                    <FluentButton OnClick="@(() => ExplainAsync(analysis.Id, r))" Disabled="@Busy">@Text["ExplainDependency"] (@r.Routes)</FluentButton>
                </TemplateColumn>
            </Columns>
            <EmptyContent><p>@Text["NoDependencyResources"]</p></EmptyContent>
        </ClarityGrid>
    </FluentCard>
}
@if (_explained is { } resource)
{
    <DetailPanel Title="@($"{Text["ExplainDependency"]} · {resource.DisplayName ?? resource.ObjectId.ToString()}")" Error="@Error" Close="@(() => _explained = null)">
        <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["DependencyRoutes"]</FluentText>
        <ul>
            @foreach (var link in _links.Where(l => l.Kind == DependencyLinkKind.Route))
            { <li><FluentLink Href="@Sheet(link.ObjectId)">@(link.Label ?? link.ObjectId.ToString())</FluentLink> · @Text[$"ObjectType_{link.Type}"] · @Text[$"Relation_{link.Route}"]</li> }
            @if (resource.Routes == 0) { <li>@Text["DirectDependencyOnly"]</li> }
            else if (resource.Routes > _links.Count(l => l.Kind == DependencyLinkKind.Route)) { <li>@Text["MoreRoutes"] : @resource.Routes</li> }
        </ul>
        <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["DependencySamples"]</FluentText>
        <ul>
            @foreach (var link in _links.Where(l => l.Kind == DependencyLinkKind.Principal))
            {
                <li><FluentLink Href="@Sheet(link.ObjectId)">@(link.Label ?? link.ObjectId.ToString())</FluentLink> · @Text[$"DependencySide_{link.Side}"] · @Route(link.Route)
                    @if (link.Via is { } via) { <small>@Text["Via"] : @via</small> }</li>
            }
        </ul>
        <p>@Text["DependencySamplesHint"]</p>
    </DetailPanel>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EnvironmentRole Side { get; set; }
    [Parameter] public IReadOnlyList<ProjectEnvironment> Environments { get; set; } = [];
    [Parameter] public bool CanQualify { get; set; }
    private IReadOnlyList<DependencySummary> _analyses = [];
    private IReadOnlyList<DependencyLinkRow> _links = [];
    private DependencySummary? _selected;
    private DependencyResourceRow? _explained;
    private Guid _environment, _operation = Guid.NewGuid();
    private string _wave = "", _family = "", _classification = "", _search = "";
    private string? _message;
    private int _revision;

    private DependencyFilter Filter => new(Enum.TryParse<DependencyFamily>(_family, out var family) ? family : null,
        Enum.TryParse<DependencyClassification>(_classification, out var value) ? value : null);

    protected override Task OnParametersSetAsync() => RunAsync(async () =>
    {
        _environment = Environments.FirstOrDefault()?.Id ?? Guid.Empty;
        _analyses = await Dependencies.AnalysesAsync(ProjectId, Side);
        _selected = _analyses.FirstOrDefault();
    });

    private string Sheet(Guid id) => $"/projects/{ProjectId}/inventory?side={Side}&object={id}";
    private string Route(string route) => string.Join(" › ", route.Split(" › ").Select(r => Text[$"Relation_{r}"] is { ResourceNotFound: false } t ? t.Value : r));
    private static int Principals(DependencySummary a, DependencySide side) => side switch
    {
        DependencySide.Migrating => a.MigratingPrincipals,
        DependencySide.OtherWave => a.OtherWavePrincipals,
        DependencySide.ToArbitrate => a.ArbitratePrincipals,
        _ => a.RemainingPrincipals
    };
    private string Size(long bytes) => bytes >= 1L << 30 ? Text["SizeGiB", bytes / (double)(1L << 30)]
        : bytes >= 1L << 20 ? Text["SizeMiB", bytes / (double)(1L << 20)] : Text["SizeBytes", bytes];
    private void Reload() => _revision++;
    private void Choose(Guid? id)
    {
        _selected = _analyses.FirstOrDefault(a => a.Id == id) ?? _selected;
        _explained = null; _revision++;
    }

    private Task AnalyzeAsync() => RunAsync(async () =>
    {
        var id = await Dependencies.AnalyzeAsync(ProjectId, _environment, _wave, _operation);
        _operation = Guid.NewGuid();
        _analyses = await Dependencies.AnalysesAsync(ProjectId, Side);
        _selected = _analyses.FirstOrDefault(a => a.Id == id);
        _explained = null; _revision++;
        _message = Messages["DependenciesAnalyzed"];
    });

    private Task ExplainAsync(Guid analysisId, DependencyResourceRow row) => RunAsync(async () =>
    {
        _links = await Dependencies.LinksAsync(ProjectId, analysisId, row.ObjectId);
        _explained = row;
    });
}
