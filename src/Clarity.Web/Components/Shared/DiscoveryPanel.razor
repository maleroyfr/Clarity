@using System.Text.Json
@using Clarity.Contracts
@using Clarity.Infrastructure
@inherits FoundationPage
@inject FoundationService Foundation
@inject DiscoveryQueries Queries
@inject GraphDiscoveryService Graph
@inject ScriptRequestService Scripts
@inject ImportService Imports
@inject JobService Jobs
@inject DiscoveryCatalog Catalog
@inject ReportProfiles Reports
@inject DiscoveryAvailability Availability
@inject WorkspaceAuthorization Authorization

<section aria-label="@Text["Discovery"]">
    @if (Error is not null) { <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="false">@Error</FluentMessageBar> }
    @if (Error is not null && ErrorDetails.Count > 0)
    {
        <ul class="error-details" aria-label="@Text["ErrorDetails"]">
            @foreach (var detail in ErrorDetails) { <li>@Detail(detail)</li> }
        </ul>
    }
    @if (_message is not null) { <FluentMessageBar Intent="MessageBarIntent.Success" AllowDismiss="false">@_message</FluentMessageBar> }
    <FluentStack Wrap="true" VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="var(--spacingHorizontalM)">
        <FluentSelect TOption="ProjectEnvironment" TValue="Guid" Items="_environments"
                      OptionText="@(x => $"{Text[x.Kind.ToString()]} · {x.ExternalId}")" OptionValue="@(x => x.Id)"
                      Value="_environmentId" ValueChanged="SelectAsync" Label="@Text["CollectionEnvironment"]" Disabled="Busy" />
        <FluentButton OnClick="ReloadAsync" Disabled="Busy">@Text["Reload"]</FluentButton>
        @if (_producerChoices.Count > 1)
        {
            <FluentSelect TOption="string" TValue="string" Items="_producerChoices"
                          OptionText="@(id => Text[$"Producer_{id}"])" Value="_producer" ValueChanged="SelectProducerAsync"
                          Label="@Text["Producer"]" Disabled="Busy" />
        }
    </FluentStack>
    @if (SelectedEnvironment is null)
    {
        <EmptyState Title="@Text["NoCollectionEnvironment"]" Description="@Text["NoSourceHint"]">
            <FluentLink Href="@($"/projects/{ProjectId}/overview")">@Text["AddEnvironment"]</FluentLink>
        </EmptyState>
    }
    else
    {
        <nav aria-label="@Text["Discovery"]"><FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalL)">
            @foreach (var tab in new[] { "Connections", "Collections", "Coverage" })
            {
                <FluentButton Appearance="@(_view == tab ? ButtonAppearance.Primary : ButtonAppearance.Default)" OnClick="@(() => _view = tab)">@Text[tab]</FluentButton>
            }
        </FluentStack></nav>
        <section @key="(_environmentId, _revision)">
        @if (_view == "Connections")
        {
            <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold" Block="true">@Text["Connections"]</FluentText>
            @if (SelectedEnvironment.Kind == EnvironmentKind.M365Tenant && !ScriptProducerSelected)
            {
                <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["ConnectionConsentHint"]</FluentMessageBar>
                @if (_connection is null)
                {
                    <FluentTextInput Label="@Text["Name"]" @bind-Value="_connectionName" Disabled="@(!_canManage || Busy)" />
                    <FluentButton OnClick="ConnectAsync" Disabled="@(!_canManage || Busy)">@Text["DeclareConnection"]</FluentButton>
                }
                else
                {
                    <FluentCard>
                        <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@_connection.Name</FluentText><p>@_connection.TenantId</p>
                        <p>@Text["LastAccessTest"] : @Date(_connection.TestedAtUtc)</p>
                        <FluentButton OnClick="TestAsync" Disabled="@(!_canCollect || !Availability.Graph || Busy)">@Text["TestSections"]</FluentButton>
                    </FluentCard>
                    @foreach (var check in _connection.Checks)
                    {
                        <FluentCard>
                            <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@SectionName(check.CapabilityId) · @Text[check.Available ? "AccessAvailable" : "AccessUnavailable"]</FluentText>
                            <p>@Text["Permissions"] : @string.Join(", ", check.Permissions)</p>
                            @if (check.Code != "Available") { <p>@Issue(check.Code) <code>@check.Code</code></p> }
                        </FluentCard>
                    }
                }
                @if (!Availability.Graph) { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["GraphConfigurationRequired"]</FluentMessageBar> }
                <p>@Text[_producer switch
                {
                    IntuneCollector.ProducerId => "IntunePrerequisiteHint",
                    ApplicationsSsoCollector.ProducerId => "SsoPrerequisiteHint",
                    SharePointCollector.ProducerId => "SharePointPrerequisiteHint",
                    OneDriveCollector.ProducerId => "OneDrivePrerequisiteHint",
                    TeamsCollector.ProducerId => "TeamsPrerequisiteHint",
                    _ => "GraphAlternativeHint"
                }]</p>
            }
            else
            {
                <p>@ScriptText("LocalScriptConnectionHint", _producer)</p>
            }
        }
        else if (_view == "Collections")
        {
            <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold" Block="true">@Text["Collections"]</FluentText>
            @if (_availableSections.Length > 0)
            {
                <FluentCard Class="discovery-form">
                    <FluentSelect TOption="string" TValue="string" Items="_availableSections" Multiple="true"
                        @bind-SelectedItems="_sections" OptionText="SectionName" Label="@Text["SelectSections"]" Disabled="@(!_canCollect || Busy)" />
                    @if (SelectedEnvironment.Kind == EnvironmentKind.M365Tenant && !ScriptProducerSelected)
                    {
                        <p>@Text["Scope"] : @SelectedEnvironment.ExternalId</p>
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="LaunchAsync"
                            Disabled="@(!_canCollect || !Availability.Graph || _connection is null || Busy)">@Text["LaunchCollection"]</FluentButton>
                        @if (_connection is null || !Availability.Graph) { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["PrepareGraphHint"]</FluentMessageBar> }
                    }
                    else if (ScriptProducerSelected)
                    {
                        @if (BoundToEnvironment)
                        {
                            <p>@Text["Scope"] : @SelectedEnvironment.ExternalId</p>
                        }
                        else
                        {
                            <FluentSelect TOption="string" TValue="string" Items="ScopeKinds"
                                @bind-Value="_scopeKind" OptionText="@(kind => Text[$"ScopeKind_{kind}"])" Label="@Text["ScopeKind"]" Disabled="@(!_canCollect || Busy)" />
                            <FluentTextInput Label="@ScriptText("ScopeValue", _producer)" @bind-Value="_scopeValue" Disabled="@(!_canCollect || Busy)" />
                            @if (_scopeKind == "ou") { <FluentTextInput Label="@Text["AdDomain"]" @bind-Value="_domain" Disabled="@(!_canCollect || Busy)" /> }
                        }
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="RequestAsync" Disabled="@(!_canCollect || Busy)">@ScriptText("CreateScriptRequest", _producer)</FluentButton>
                    }
                </FluentCard>
            }
            else { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["ProducerUnavailable"]</FluentMessageBar> }
            <FluentCard>
                <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["UploadResult"]</FluentText>
                <p>@Text["UploadResultHint"]</p>
                @if (Availability.Storage && _canCollect)
                {
                    <FluentButton Id="choose-zip" Disabled="@Busy" IconStart="@(new Icons.Regular.Size20.ArrowUpload())">@Text["ResultFile"]</FluentButton>
                    <FluentInputFile Id="discovery-zip" AnchorId="choose-zip" DragDropZoneVisible="false"
                                     OnInputFileChange="UploadAsync" Accept=".zip" Disabled="@Busy" />
                }
                else if (!Availability.Storage) { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["StorageRequired"]</FluentMessageBar> }
                else { <p>@Text["ReadOnlyDiscovery"]</p> }
            </FluentCard>
            @if (_profiles.Count > 0)
            {
                <FluentCard>
                    <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["ImportReportTitle"]</FluentText>
                    <p>@Text["ImportReportHint"]</p>
                    <FluentSelect TOption="ReportProfile" TValue="string" Items="_profiles" OptionText="ProfileLabel" OptionValue="ProfileKey"
                        @bind-Value="_profileKey" Label="@Text["ReportProfile"]" Disabled="@(!_canCollect || Busy)" />
                    @if (SelectedProfile is { } profile)
                    {
                        <p>@Text[$"ReportProfileHint_{profile.Id}"]</p>
                        <p>@Text["ReportFormat"] : @Text["ReportFormatValue"]</p>
                        <p>@Text["RequiredColumns"] :
                            @foreach (var column in profile.Columns.Where(x => x.Required)) { <code>@column.Header</code> @(" ") }</p>
                        <p>@Text["ReportIdentity"] :
                            @foreach (var identity in profile.Object.Identities) { <code>@identity.Column → @identity.Namespace</code> @(" ") }</p>
                        <FluentAccordion><FluentAccordionItem Header="@Text["DeclaredCoverage"]">
                            <ul>@foreach (var limit in profile.Coverage.Limits) { <li>@Text[$"ReportLimit_{limit.Code}"]</li> }</ul>
                        </FluentAccordionItem></FluentAccordion>
                    }
                    @if (Availability.Storage && _canCollect)
                    {
                        <FluentTextInput Label="@Text["ReportTenantScope"]" @bind-Value="_reportScope" Disabled="Busy" />
                        <FluentCheckbox Id="report-scope-attested" Label="@Text["ReportScopeAttestation"]" @bind-Value="_reportAttested" Disabled="@Busy" />
                        <FluentButton Id="choose-report" Disabled="@(Busy || !_reportAttested || SelectedProfile is null)"
                                      IconStart="@(new Icons.Regular.Size20.ArrowUpload())">@Text["ReportFile"]</FluentButton>
                        <FluentInputFile Id="discovery-report" AnchorId="choose-report" DragDropZoneVisible="false"
                                         OnInputFileChange="UploadReportAsync" Accept=".csv" Disabled="@(Busy || !_reportAttested || SelectedProfile is null)" />
                    }
                    else if (!Availability.Storage) { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["StorageRequired"]</FluentMessageBar> }
                    else { <p>@Text["ReadOnlyDiscovery"]</p> }
                </FluentCard>
            }
            <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["RequestHistory"]</FluentText>
            <ClarityGrid TGridItem="RequestView" Load="LoadRequestsAsync">
                <Columns>
                    <PropertyColumn Property="@(x => x.CreatedAtUtc)" Title="@Text["Date"]" Sortable="true" />
                    <TemplateColumn Title="@Text["Scope"]" Context="request">@ScopeValue(request.ScopeJson)</TemplateColumn>
                    <TemplateColumn Title="@Text["Status"]" Context="request">@Text[request.State.ToString()]</TemplateColumn>
                    <TemplateColumn Title="@Text["Actions"]" Context="request"><FluentButton OnClick="@(() => _request = request)">@Text["ScriptDownloads"]</FluentButton></TemplateColumn>
                </Columns>
                <EmptyContent><p>@Text["NoRequests"]</p></EmptyContent>
            </ClarityGrid>
            <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["RunHistory"]</FluentText>
            <ClarityGrid TGridItem="RunView" Load="LoadRunsAsync">
                <Columns>
                    <PropertyColumn Property="@(x => x.StartedAtUtc)" Title="@Text["Date"]" Sortable="true" />
                    <TemplateColumn Title="@Text["Producer"]" Context="run">@run.ProducerId @run.ProducerVersion</TemplateColumn>
                    <TemplateColumn Title="@Text["Status"]" Context="run">@Text[run.ConfirmedAtUtc is null ? "FileToConfirm" : run.State.ToString()]</TemplateColumn>
                    <TemplateColumn Title="@Text["Actions"]" Context="run"><FluentButton OnClick="@(() => PreviewAsync(run.Id))">@Text["Preview"]</FluentButton></TemplateColumn>
                </Columns>
                <EmptyContent><p>@Text["NoRuns"]</p></EmptyContent>
            </ClarityGrid>
            <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@Text["ProjectJobs"]</FluentText>
            <ClarityGrid TGridItem="JobView" Load="LoadJobsAsync">
                <Columns>
                    <PropertyColumn Property="@(x => x.CreatedAtUtc)" Title="@Text["Date"]" Sortable="true" />
                    <TemplateColumn Title="@Text["Status"]" Context="job">
                        @Text[job.State.ToString()]
                        @if (job.CancellationRequested) { <span> · @Text["CancellationRequested"]</span> }
                        @if (job.ErrorCode is not null) { <p>@Issue(job.ErrorCode) <code>@job.ErrorCode</code></p> }
                        <small>@Text["Correlation"] : @job.CorrelationId</small>
                    </TemplateColumn>
                    <TemplateColumn Title="@Text["Progress"]" Context="job">@job.Progress @Text["PublishedSections"] · @Text["Attempt"] @job.Attempt</TemplateColumn>
                    <TemplateColumn Title="@Text["Actions"]" Context="job">
                        @if (job.State is CollectionRunState.Failed or CollectionRunState.Cancelled)
                        { <FluentButton OnClick="@(() => RetryAsync(job.Id))" Disabled="@(!_canCollect || Busy)">@Text["Retry"]</FluentButton> }
                        else if (job.State is CollectionRunState.Pending or CollectionRunState.Running)
                        { <FluentButton OnClick="@(() => CancelAsync(job.Id))" Disabled="@(!_canCollect || Busy || job.CancellationRequested)">@Text["Cancel"]</FluentButton> }
                    </TemplateColumn>
                </Columns>
                <EmptyContent><p>@Text["NoJobs"]</p></EmptyContent>
            </ClarityGrid>
        }
        else
        {
            <FluentText As="TextTag.H2" Size="TextSize.Size600" Weight="TextWeight.Semibold" Block="true">@Text["Coverage"]</FluentText>
            <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["CoverageLegend"]</FluentMessageBar>
            @foreach (var capability in _uncollected)
            { <p>@SectionName(capability) : @Text["NotCollected"]</p> }
            <ClarityGrid TGridItem="CoverageView" Load="LoadCoverageAsync">
                <Columns>
                    <PropertyColumn Property="@(x => x.CapabilityId)" Title="@Text["Section"]" Sortable="true" />
                    <TemplateColumn Title="@Text["Scope"]" Context="row">@ScopeValue(row.ScopeJson)</TemplateColumn>
                    <TemplateColumn Title="@Text["Coverage"]" Context="row">@Text[row.Coverage?.ToString() ?? "NotPublished"]</TemplateColumn>
                    <TemplateColumn Title="@Text["ObjectsRelations"]" Context="row">@Count(row.ObjectCount, row.Coverage) / @Count(row.RelationshipCount, row.Coverage)</TemplateColumn>
                    <TemplateColumn Title="@Text["LastValidObservation"]" Context="row">
                        @if (row.LastValidRunId is { } validId) { <FluentButton OnClick="@(() => PreviewAsync(validId))">@Date(row.LastValidAtUtc)</FluentButton> }
                        else { @Text["Unknown"] }
                    </TemplateColumn>
                    <TemplateColumn Title="@Text["Actions"]" Context="row">
                        <FluentButton OnClick="@(() => PreviewAsync(row.RunId))">@Text["SectionResults"]</FluentButton>
                        @if (row.Coverage.HasValue) { <FluentButton OnClick="@(() => _proof = new(ProofKind.Section, row.SectionRunId))">@Text["Provenance"]</FluentButton> }
                    </TemplateColumn>
                </Columns>
                <EmptyContent><p>@Text["NoInventory"]</p></EmptyContent>
            </ClarityGrid>
        }
        </section>
    }
</section>
@if (_proof is not null)
{
    <ProvenancePanel @key="(ProjectId, _proof)" ProjectId="ProjectId" Target="_proof" Close="@(() => _proof = null)" />
}
@if (_request is not null)
{
    <DetailPanel Title="@Text["ScriptDownloads"]" Close="@(() => _request = null)">
        <p>@_request.Id · @_request.ScriptVersion</p>
        <p>@Text["Scope"] : @ScopeValue(_request.ScopeJson)</p>
        <p><FluentLink Href="@RequestUrl(_request.Id, "bundle")" download ForceLoad="true">@ScriptText("DownloadScriptBundle", _request.ProducerId)</FluentLink></p>
        <p><FluentLink Href="@RequestUrl(_request.Id, "parameters")" download ForceLoad="true">@Text["DownloadParameters"]</FluentLink></p>
        <p>@ScriptText("ScriptCommandHint", _request.ProducerId)</p>
        <pre><code>@ScriptBundle.Command(_request.ProducerId)</code></pre>
        <p>@Text["SeparateMachineHint"]</p>
    </DetailPanel>
}
@if (_preview is not null)
{
    <DetailPanel Title="@Text["Preview"]" Error="@Error" Close="@(() => _preview = null)">
        <p>@_preview.Run.ProducerId @_preview.Run.ProducerVersion</p>
        <p>@Text["Scope"] : @ScopeValue(_preview.Run.ScopeJson)</p>
        <p>@Date(_preview.Run.StartedAtUtc) — @Date(_preview.Run.CompletedAtUtc)</p>
        <p>@Text["RunIdentifier"] : @_preview.Run.ExternalRunId</p>
        <p>SHA-256 : <code>@_preview.Run.ContentHash</code></p>
        <p>@Text["NewObjects"] : @_preview.NewObjects · @Text["ExistingObjects"] : @_preview.ExistingObjects</p>
        @if (_preview.Report is { } report) { <ReportPreview Report="report" /> }
        @foreach (var result in _preview.Sections)
        {
            <FluentCard>
                <FluentText As="TextTag.H3" Size="TextSize.Size500" Weight="TextWeight.Semibold" Block="true">@SectionName(result.CapabilityId) · @Text[result.Status.ToString()]</FluentText>
                <p>@Text["ObjectsRelations"] : @Count(result.ObjectCount, result.Status) / @Count(result.RelationshipCount, result.Status)</p>
                <p>@Text["CoveredFields"] : @string.Join(", ", result.CoveredFields)</p>
                <p>@Text["CoveredRelations"] : @string.Join(", ", result.CoveredRelations)</p>
                @foreach (var issue in result.Warnings.Concat(result.Errors)) { <p>@Issue(issue.Code) <code>@issue.Code</code></p> }
            </FluentCard>
        }
        <p>@Text["PreviewSampleHint"]</p>
        <FluentAccordion><FluentAccordionItem Header="@Text["ObjectSample"]"><pre>@JsonSerializer.Serialize(_preview.Objects, ContractJson.Options)</pre></FluentAccordionItem></FluentAccordion>
        <FluentAccordion><FluentAccordionItem Header="@Text["RelationSample"]"><pre>@JsonSerializer.Serialize(_preview.Relationships, ContractJson.Options)</pre></FluentAccordionItem></FluentAccordion>
        <p><FluentLink Href="@($"/api/projects/{ProjectId}/discovery/runs/{_preview.Run.Id}/download")" download ForceLoad="true">@Text["DownloadRawResult"]</FluentLink></p>
        @if (_preview.Run.ConfirmedAtUtc is null)
        {
            @if (_preview.Report is { } diagnostics && (diagnostics.UsableRows == 0 || _preview.Sections.Any(x => x.Status == CoverageStatus.Failed)))
            {
                <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["NothingToPublish"]</FluentMessageBar>
            }
            else
            {
                <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["ConfirmationHint"]</FluentMessageBar>
                @if (_preview.Report is not null && _preview.Sections.Any(x => x.Status == CoverageStatus.Partial))
                { <FluentMessageBar Intent="MessageBarIntent.Info" AllowDismiss="false">@Text["ReportPartialHint"]</FluentMessageBar> }
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ConfirmAsync" Disabled="@(!_canCollect || Busy)">@Text["ConfirmPublication"]</FluentButton>
            }
        }
    </DetailPanel>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public EnvironmentRole Side { get; set; }
    [Parameter] public string? InitialView { get; set; }
    private IReadOnlyList<ProjectEnvironment> _environments = [];
    private ProjectEnvironment? SelectedEnvironment => _environments.FirstOrDefault(x => x.Id == _environmentId);
    private Guid _environmentId, _operationId = Guid.NewGuid();
    private readonly Dictionary<string, Guid> _reportOperations = new(StringComparer.Ordinal);
    private string _view = "Connections", _connectionName = "Microsoft Graph", _scopeKind = "domain", _scopeValue = "", _domain = "";
    private string? _message;
    private bool _canCollect, _canManage;
    private int _revision;
    private string[] _availableSections = [];
    private string _producer = GraphDiscoveryService.EntraProducerId;
    private IReadOnlyList<string> _producerChoices = [], _scriptProducers = [];
    private IEnumerable<string> _sections = [];
    private IReadOnlyList<string> _uncollected = [];
    private IReadOnlyList<ReportProfile> _profiles = [];
    private string _profileKey = "", _reportScope = "";
    private bool _reportAttested;
    private ReportProfile? SelectedProfile => _profiles.FirstOrDefault(x => ProfileKey(x) == _profileKey);
    private ConnectionView? _connection;
    private RequestView? _request;
    private ProofRef? _proof;
    private PreviewView? _preview;

    protected override Task OnParametersSetAsync() => RunAsync(async () =>
    {
        if (InitialView is "Connections" or "Collections" or "Coverage") { _view = InitialView; }
        await LoadAsync();
    });
    private async Task LoadAsync()
    {
        var project = await Foundation.GetProjectAsync(ProjectId);
        _canCollect = project.Status == ProjectStatus.Active && Authorization.Allows(project.WorkspaceId, WorkspaceOperation.Collect);
        _canManage = project.Status == ProjectStatus.Active && Authorization.Allows(project.WorkspaceId, WorkspaceOperation.ManageConnections);
        _environments = (await Foundation.ListEnvironmentsAsync(ProjectId)).Where(x => x.Role == Side && x.TargetState == TargetState.Existing).ToArray();
        if (!_environments.Any(x => x.Id == _environmentId)) { _environmentId = _environments.FirstOrDefault()?.Id ?? Guid.Empty; }
        await LoadSelectedAsync();
    }
    private async Task LoadSelectedAsync()
    {
        _connection = null; _preview = null; _request = null; _proof = null; _uncollected = [];
        _scriptProducers = SelectedEnvironment is null ? [] : Scripts.Producers(SelectedEnvironment.Kind).Select(x => x.Id).ToArray();
        _producerChoices = SelectedEnvironment is null ? [] : (SelectedEnvironment.Kind == EnvironmentKind.M365Tenant ? GraphDiscoveryService.ConnectionProducerIds : []).Concat(_scriptProducers).ToArray();
        if (!_producerChoices.Contains(_producer)) { _producer = _producerChoices.FirstOrDefault() ?? GraphDiscoveryService.EntraProducerId; }
        _availableSections = SelectedEnvironment is null ? [] : Catalog.Families.Where(x => x.EnvironmentKind == SelectedEnvironment.Kind.ToString())
            .SelectMany(x => x.Sections).Where(x => x.ProducerIds.Any(id => Catalog.Producers[id].Readiness == "SyntheticValidated"
                && !Catalog.Producers[id].Preview && (SelectedEnvironment.Kind == EnvironmentKind.M365Tenant || _scriptProducers.Count > 0
                    ? id == _producer || id == GraphReportDownloads.ReportProducer(x, _producer)
                    : Catalog.Producers[id].Channel != "Import"))).Select(x => x.Id).ToArray();
        if (!ScopeKinds.Contains(_scopeKind)) { _scopeKind = ScopeKinds.FirstOrDefault() ?? "domain"; }
        _sections = _availableSections;
        _profiles = SelectedEnvironment is null ? [] : Reports.Supported.Where(x => x.EnvironmentKind == SelectedEnvironment.Kind.ToString()).ToArray();
        if (SelectedProfile is null) { _profileKey = _profiles.Count > 0 ? ProfileKey(_profiles[0]) : ""; }
        _reportScope = SelectedEnvironment?.ExternalId ?? "";
        _reportAttested = false;
        if (SelectedEnvironment is not null)
        {
            if (!ScriptProducerSelected) { _connection = await Queries.ConnectionAsync(ProjectId, _environmentId, producerId: _producer); }
            _uncollected = await Queries.UncollectedAsync(ProjectId, _environmentId);
        }
        _revision++;
    }
    private Task SelectAsync(Guid id) => RunAsync(async () => { _environmentId = id; NewOperation(); _message = null; await LoadSelectedAsync(); });
    private void NewOperation() { _operationId = Guid.NewGuid(); _reportOperations.Clear(); }
    private Task ReloadAsync() => RunAsync(LoadAsync);
    private Task SelectProducerAsync(string id) => RunAsync(async () =>
    {
        _producer = id; NewOperation(); _message = null; await LoadSelectedAsync();
    });
    private Task ConnectAsync() => RunAsync(async () => { await Graph.ConnectAsync(ProjectId, _environmentId, _connectionName, producerId: _producer); await LoadSelectedAsync(); });
    private Task TestAsync() => RunAsync(async () =>
    {
        await Graph.TestAsync(ProjectId, _environmentId, _connection!.Id);
        _connection = await Queries.ConnectionAsync(ProjectId, _environmentId, producerId: _producer);
    });
    private Task LaunchAsync() => RunAsync(async () =>
    {
        CollectionScope scope = new("tenant", Guid.Parse(SelectedEnvironment!.ExternalId).ToString());
        var selected = _sections.ToArray();
        // Each downloadable report is its own Import producer and runs as a single-section job with a stable operation ID.
        var reports = selected.Where(x => Catalog.Sections[x].ProducerIds.Any(id => Catalog.Producers[id].Channel == "Import")).ToArray();
        var collections = selected.Except(reports, StringComparer.Ordinal).ToArray();
        if (collections.Length > 0 || reports.Length == 0)
        {
            await Graph.LaunchAsync(ProjectId, _environmentId, _connection!.Id, _operationId, scope, collections);
        }
        foreach (var report in reports)
        {
            if (!_reportOperations.TryGetValue(report, out var operation)) { _reportOperations[report] = operation = Guid.NewGuid(); }
            await Graph.LaunchAsync(ProjectId, _environmentId, _connection!.Id, operation, scope, [report]);
        }
        NewOperation(); _message = Text["CollectionQueued"]; _revision++;
    });
    private Task RequestAsync() => RunAsync(async () =>
    {
        var bound = BoundToEnvironment;
        CollectionScope scope = bound ? new("tenant", SelectedEnvironment!.ExternalId) : new(_scopeKind, _scopeValue);
        var id = await Scripts.CreateAsync(ProjectId, _environmentId, _operationId, scope, _sections.ToArray(), scope.Kind == "ou" ? _domain : null);
        _request = new RequestView(id, DiscoveryScope.Serialize(scope), Catalog.Producers[_producer].Version, CollectionRequestState.AwaitingFile,
            DateTimeOffset.UtcNow, _producer);
        NewOperation(); _revision++;
    });
    private Task UploadAsync(InputFileChangeEventArgs args) => RunAsync(async () =>
    {
        await using var stream = args.File.OpenReadStream(new PackageLimits().CompressedBytes);
        var id = await Imports.UploadAsync(ProjectId, _environmentId, stream, args.File.Name);
        _preview = DiscoveryQueries.Present(await Imports.PreviewAsync(ProjectId, id)); _revision++;
    });
    private Task PreviewAsync(Guid id) => RunAsync(async () => _preview = DiscoveryQueries.Present(await Imports.PreviewAsync(ProjectId, id)));
    private Task UploadReportAsync(InputFileChangeEventArgs args) => RunAsync(async () =>
    {
        var profile = SelectedProfile ?? throw new ContractException("ReportProfileUnavailable", "profile");
        var limit = new PackageLimits().CompressedBytes;
        if (args.File.Size > limit) { throw new ContractException("ReportFileTooLarge", CsvReportReader.FileName); }
        await using var stream = args.File.OpenReadStream(limit);
        var id = await Imports.UploadReportAsync(ProjectId, _environmentId, profile.Id, profile.Version,
            new(profile.ScopeKind, _reportScope), _reportAttested, stream, args.File.Name);
        _reportAttested = false;
        _preview = DiscoveryQueries.Present(await Imports.PreviewAsync(ProjectId, id)); _revision++;
    });
    private Task ConfirmAsync() => RunAsync(async () =>
    {
        await Imports.ConfirmAsync(ProjectId, _preview!.Run.Id);
        _preview = null; _message = Text["CollectionQueued"]; _view = "Collections"; await LoadSelectedAsync();
    });
    private Task CancelAsync(Guid id) => RunAsync(async () => { await Jobs.CancelAsync(ProjectId, id); _revision++; });
    private Task RetryAsync(Guid id) => RunAsync(async () => { await Jobs.RetryAsync(ProjectId, id); _revision++; });
    private Task<PageResult<RunView>> LoadRunsAsync(PageRequest page, CancellationToken ct) => Queries.RunsAsync(ProjectId, _environmentId, page, ct);
    private Task<PageResult<RequestView>> LoadRequestsAsync(PageRequest page, CancellationToken ct) => Queries.RequestsAsync(ProjectId, _environmentId, page, ct);
    private Task<PageResult<JobView>> LoadJobsAsync(PageRequest page, CancellationToken ct) => Queries.JobsAsync(ProjectId, page, ct);
    private Task<PageResult<CoverageView>> LoadCoverageAsync(PageRequest page, CancellationToken ct) => Queries.CoverageAsync(ProjectId, _environmentId, page, ct);
    private string RequestUrl(Guid id, string kind) => $"/api/projects/{ProjectId}/discovery/requests/{id}/{kind}";
    private bool ScriptProducerSelected => _scriptProducers.Contains(_producer);
    private string[] ScopeKinds => _availableSections.Length == 0 ? [] : _availableSections.Select(id => Catalog.Sections[id].SupportedScopes)
        .Aggregate(Catalog.Sections[_availableSections[0]].SupportedScopes, (kinds, next) => kinds.Intersect(next).ToArray()).ToArray();
    // A family whose sections only support the tenant scope is always bound to the environment's tenant.
    private bool BoundToEnvironment => ScopeKinds is ["tenant"];
    // A producer may override the AD-worded default text with a "<key>_<producerId>" resource.
    private string ScriptText(string key, string producerId) => Text[$"{key}_{producerId}"] is { ResourceNotFound: false } text ? text.Value : Text[key];
    private string SectionName(string id) => Text[$"Section_{id}"];
    private string Issue(string code) => Text[$"Issue_{code}"].ResourceNotFound ? Text["CollectionRemediation"] : Text[$"Issue_{code}"];
    private static string ProfileKey(ReportProfile profile) => $"{profile.Id}@{profile.Version}";
    private string ProfileLabel(ReportProfile profile) => $"{ReportPreview.ProfileName(Text, profile.Id)} · v{profile.Version}";
    private string Detail(string detail) => detail.Split('|') is [var line, var column, var code] && int.TryParse(line, out var number)
        ? ReportPreview.RowIssue(Text, number, column, code)
        : Text[$"ReportProfile_{detail}"] is { ResourceNotFound: false } profile ? profile.Value : detail;
    private string Date(DateTimeOffset? date) => date is null ? Text["Unknown"]
        : date.Value.UtcDateTime.ToString("g", System.Globalization.CultureInfo.GetCultureInfo("fr-FR")) + " UTC";
    private string Count(long? value, CoverageStatus? status) => status == CoverageStatus.NotApplicable ? Text["NotApplicable"]
        : value is null ? Text["Unknown"] : value == 0 && status == CoverageStatus.Complete ? Text["KnownZero"] : value.Value.ToString(System.Globalization.CultureInfo.CurrentCulture);
    private static string ScopeValue(string json) => JsonSerializer.Deserialize<CollectionScope>(json, ContractJson.Options)!.Value;
}
