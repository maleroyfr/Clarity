@typeparam TGridItem
@attribute [CascadingTypeParameter(nameof(TGridItem))]
@implements IDisposable
@inject ILogger<ClarityGrid<TGridItem>> Logger

<div class="grid-container">
    <FluentDataGrid TGridItem="TGridItem" ItemsProvider="ProvideAsync" Pagination="_pagination" @ref="_grid"
                    HandleLoadingError="HandleError">
        <ChildContent>@Columns</ChildContent>
        <LoadingContent><p role="status">@Text["Loading"]</p></LoadingContent>
        <EmptyContent>@EmptyContent</EmptyContent>
        <ErrorContent><p role="alert">@Text["Error"]</p></ErrorContent>
    </FluentDataGrid>
</div>
<nav class="pagination" aria-label="@Text["Page"]">
    <FluentButton Disabled="@(_pagination.CurrentPageIndex == 0)" OnClick="PreviousAsync">@Text["Previous"]</FluentButton>
    <span aria-live="polite">@Text["Page"] @(_pagination.CurrentPageIndex + 1) · @(_pagination.TotalItemCount ?? 0) @Text["Items"]</span>
    <FluentButton Disabled="@(_pagination.LastPageIndex is null || _pagination.CurrentPageIndex >= _pagination.LastPageIndex)" OnClick="NextAsync">@Text["Next"]</FluentButton>
</nav>

@code {
    [Parameter, EditorRequired] public Func<PageRequest, CancellationToken, Task<PageResult<TGridItem>>> Load { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment Columns { get; set; } = default!;
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    [Parameter] public string Search { get; set; } = "";
    private readonly PaginationState _pagination = new() { ItemsPerPage = 20 };
    private FluentDataGrid<TGridItem>? _grid;

    protected override void OnInitialized() => _pagination.TotalItemCountChanged += TotalChanged;
    private void TotalChanged(object? sender, TotalItemCountChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => _pagination.TotalItemCountChanged -= TotalChanged;

    private async ValueTask<GridItemsProviderResult<TGridItem>> ProvideAsync(GridItemsProviderRequest<TGridItem> request)
    {
        var sort = request.GetSortByProperties().FirstOrDefault();
        var result = await Load(new(request.StartIndex, request.Count ?? 20, Search, sort.Direction == DataGridSortDirection.Descending,
            sort.PropertyName), request.CancellationToken);
        return GridItemsProviderResult.From(result.Items.ToArray(), result.TotalCount);
    }

    private bool HandleError(Exception exception)
    {
        Logger.LogWarning("Grid request failed with {ErrorType}", exception.GetType().Name);
        return true;
    }

    public async Task RefreshAsync()
    {
        await _pagination.SetCurrentPageIndexAsync(0);
        if (_grid is not null) { await _grid.RefreshDataAsync(); }
    }
    private Task PreviousAsync() => _pagination.SetCurrentPageIndexAsync(_pagination.CurrentPageIndex - 1);
    private Task NextAsync() => _pagination.SetCurrentPageIndexAsync(_pagination.CurrentPageIndex + 1);
}
